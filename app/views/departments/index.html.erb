<div class="m-5">
  <h1 class="text-3xl font-semibold text-gray-800 mb-6">Departments</h1>

  <div class="mb-4">
    <%= link_to 'Create Department', new_department_path, data: { turbo_frame: dom_id(Department.new) }, class: "btn btn-primary btn-xs py-2 px-4 font-semibold rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50" %>
  </div>

  <%= turbo_frame_tag "new_department" %>

  <div class="grid grid-cols-5 sm:grid-cols-1 lg:grid-cols-3 gap-6">
    <%= render partial: 'department', collection: @departments, as: :department %>
  </div>
</div>
