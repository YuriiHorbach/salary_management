<%= turbo_frame_tag dom_id(@salary) do %>
  <div class="space-y-4">
    <%= form_with model: [@employee, @salary], local: true, class: 'm-5 mx-auto border-4 p-3 rounded-lg' do |form| %>
  <div class="mb-5">
    <div class="grid grid-cols-6 gap-x-3">
      <div class="col-span-3">
        <%= form.label :amount, class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :amount, step: 0.01, class:"p-1 cursor-pointer border-b-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
      <div class="col-span-3">
        <%= form.label :paid_on, class: "block text-sm font-medium text-gray-700" %>
        <%= form.date_field :paid_on, class:"p-1 cursor-pointer border-b-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>
  </div>
  <div class="mt-4">
    <%= form.submit "Save Salary Record", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
  </div>
<% end %>

  </div>
<% end %>


<%= link_to 'Back', employee_salaries_path(@employee), class: 'mt-1 inline-block text-blue-500 hover:underline' %>
