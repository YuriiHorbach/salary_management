<%= turbo_frame_tag dom_id(@employee) do %>
  <%= form_with model: @employee, local: false, class:'m-5 max-w-sm mx-auto border-4 p-3 rounded-lg' do |form| %>
    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :id_code %>
      </div>
      <div class="">
        <%= form.text_field :id_code, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :last_name %>
      </div>
      <div class="">
        <%= form.text_field :last_name, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
          <%= form.label :first_name %>
      </div>
      <div class="">
        <%= form.text_field :first_name, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :patronic_name %>

      </div>
      <div class="">
        <%= form.text_field :patronic_name, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :children_count %>

      </div>
      <div class="">
        <%= form.text_field :children_count, min: 0, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :chaes, 'CHAES Rescue member' %>

      </div>
      <div>
        <%= form.check_box :chaes, { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" }, "1", "0" %>
      </div>
    </div>

    <div class="mb-5">
    <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
      <%= form.label :contract, 'Contract' %>

    </div>
    <div>
      <%= form.check_box :contract, { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" }, "1", "0" %>
    </div>
  </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :disability_group, 'Special income sign' %>

      </div>
      <div>
        <%= form.select :disability_group,
                          [["Немає", 0], ["I група", 1], ["II група", 2], ["III група", 3], ["low income", 4]],
                          {},
                          { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" } %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :territory_sign_id, "Теріторіальна ознака (Бригада)" %>

      </div>
      <div>
        <%= form.collection_select :territory_sign_id,
                          TerritorySign.all.order(:name),
                          :id, :name,
                          { include_blank: 'Оберіть бригаду' },
                          { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" } %>
      </div>
    </div>

    <% if @employee.account_book %>
      <%= form.fields_for :account_book, @employee.account_book do |ab_form| %>
        <div class="mb-5">
          <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            <%= ab_form.label :book_name, "Назва книги" %>

          </div>
          <div>
            <%= ab_form.text_field :book_name, maxlength: 30, class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
          </div>
        </div>

        <div class="mb-5">
          <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            <%= ab_form.label :book_number, "Номер книги" %>

          </div>
          <div>
            <%= ab_form.number_field :book_number, min: 1, class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
          </div>
        </div>

        <div class="mb-5">
          <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
            <%= ab_form.label :page_number, "Номер сторінки" %>

          </div>
          <div>
            <%= ab_form.number_field :page_number, min: 1, class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="mb-5">
        <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
          <span class="text-gray-500 text-sm">Облікову книжку можна додати після збереження працівника</span>
        </div>
      </div>
    <% end %>

    <div class="mt-3">
      <%= form.submit "Submit", class: "btn btn-primary px-3 py-2 text-xs font-medium text-center inline-flex items-center" %>
      <%= link_to "Cancel", employees_path, class: "btn btn-secondary px-3 py-2 text-xs font-medium text-center inline-flex items-center" %>
    </div>
  <% end %>
<% end %>
