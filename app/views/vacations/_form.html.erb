<%= form_with(model: [@employee, vacation],
    data: { turbo_frame: dom_id(vacation) },
    class: "grid grid-cols-5 items-center bg-blue-50 dark:bg-blue-900/20 py-2 border-b-2 border-blue-200") do |f| %>

  <% input_classes = "block w-full border border-gray-300 rounded px-2 py-1 text-sm bg-white focus:ring-2 focus:ring-blue-500 shadow-sm dark:bg-gray-800 dark:border-gray-600 dark:text-white" %>

  <div class="px-4">
    <p>Період</p>
    <%= f.date_field :period,
        class: input_classes,
        value: f.object.period&.strftime("%Y-%m-%d") %>
  </div>

  <div class="px-4">
    <p>Сума відпустки</p>
    <%= f.number_field :vacation_amount_cents, step: 1, class: "#{input_classes} text-right" %>
  </div>

  <div class="px-4 text-right font-medium text-gray-400">
    —
  </div>

  <div class="px-4 text-center flex items-center justify-center gap-4">
    <%= f.button type: :submit, class: "hover:scale-125 transition text-lg", title: "Зберегти" do %>
      ✅
    <% end %>

    <%= link_to employee_vacations_path(@employee),
        class: "hover:scale-125 transition text-lg",
        title: "Скасувати" do %>
      ❌
    <% end %>
  </div>
<% end %>
