<% if @department %>
  <%= turbo_stream.replace "salary_cell_employee_#{@employee.id}" do %>
    <%= render 'departments/salary_cell',
               employee: @employee,
               department: @department,
               period: @salary.period,
               positions: @employee_salary_positions,
               period_salaries: @period_salaries,
               filter_position_id: @filter_position_id %>
  <% end %>

  <%= turbo_stream.update "department_total" do %>
    <%= number_to_currency(@department_total) %>
  <% end %>
<% end %>
