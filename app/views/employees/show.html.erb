<%= turbo_frame_tag dom_id(@employee) do %>
  <div class="grid grid-cols-[8rem_1fr] gap-y-2 max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
    <div class="w-32 font-semibold text-gray-500"><%= t('.id_code') %></div>
    <div class="text-gray-900"><%= @employee.id_code %></div>

    <div class="w-32 font-semibold text-gray-500"><%= t('.identifier') %></div>
    <div class="text-gray-900"><%= @employee.identifier || '—' %></div>

    <div class="w-32 font-semibold text-gray-500"><%= t('.last_name') %></div>
    <div class="text-gray-900"><%= @employee.last_name %></div>

    <div class="w-32 font-semibold text-gray-500"><%= t('.first_name') %></div>
    <div class="text-gray-900"><%= @employee.first_name %></div>

    <div class="w-32 font-semibold text-gray-500"><%= t('.patronic_name') %></div>
    <div class="text-gray-900"><%= @employee.patronic_name %></div>

    <div class="px-2 py-2 flex space-x-2">
      <%= link_to t('.edit'), edit_employee_path(@employee), class: "btn btn-primary px-3 py-1 text-xs font-medium text-center inline-flex items-center", data: { turbo_frame: dom_id(@employee) } %>
    </div>
  </div>
<% end %>

<div class="m-5">
  <%= search_form_for @salary_q, as: :salary_q, url: employee_path(@employee), method: :get, html: {class: 'mb-4 flex flex-wrap gap-4 items-end'} do |f| %>
    <% input_classes = "border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-900" %>

    <div>
      <%= f.label :amount_cents_eq, t('.salary_search.amount'), class: "block text-sm font-medium mb-1" %>
      <%= f.search_field :amount_cents_eq, value: @salary_amount_uah, class: input_classes %>
    </div>

    <div>
      <%= f.label :by_year, t('.salary_search.year'), class: "block text-sm font-medium mb-1" %>
      <%= f.select :by_year, options_for_select((2020..Date.today.year), params.dig(:salary_q, :by_year)), { include_blank: t('.salary_search.all_years') }, class: input_classes %>
    </div>

    <div>
      <%= f.label :department_id_eq, t('.salary_search.department'), class: "block text-sm font-medium mb-1" %>
      <%= f.select :department_id_eq, options_from_collection_for_select(@departments, 'id', 'name', params.dig(:salary_q, :department_id_eq)), { include_blank: t('.salary_search.all_departments') }, class: input_classes %>
    </div>

    <div>
      <%= f.submit t('.salary_search.submit'), class: 'btn btn-primary px-4 py-2 rounded-md font-medium hover:bg-blue-600' %>
    </div>
  <% end %>
</div>

<div class="m-5">
  <h2 class="mt-8 mb-2 text-lg font-bold"><%= t('.salaries_by_department') %></h2>
  <table class="min-w-full text-left text-sm font-light text-surface dark:text-white border">
    <thead class="bg-gray-200 dark:bg-gray-700">
      <tr>
        <th class="px-2 py-1">
          <%= sort_link(@salary_q, :department_name, t('.department'), default_order: :asc) %>
        </th>
        <th class="px-2 py-1">
          <%= sort_link(@salary_q, :amount_cents, t('.amount')) %>
        </th>
        <th class="px-2 py-1">
          <%= sort_link(@salary_q, :paid_on, t('.paid_on')) %>
        </th>
      </tr>
    </thead>
    <tbody>
      <% if @employee_salaries.any? %>
        <% @employee_salaries.each do |department, salaries| %>
          <% salaries.each do |salary| %>
            <tr class="border-b border-gray-100 dark:border-gray-700">
              <td class="px-2 py-1"><%= department&.name || t('.no_department') %></td>
              <td class="px-2 py-1"><%= number_to_currency(salary.amount) %></td>
              <td class="px-2 py-1"><%= salary.paid_on&.strftime('%d-%m-%Y') %></td>
            </tr>
          <% end %>
        <% end %>
      <% else %>
        <tr><td colspan="3" class="p-4 text-center text-gray-500 italic"><%= t('.no_salaries') %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="m-5">
  <h2 class="mt-8 mb-2 text-lg font-bold"><%= t('.monthly_totals') %></h2>
  <table class="min-w-full text-left text-sm font-light text-surface dark:text-white border mb-8">
    <thead class="bg-gray-200 dark:bg-gray-700">
      <tr>
        <th class="px-2 py-1"><%= t('.month') %></th>
        <th class="px-2 py-1"><%= t('.amount') %></th>
      </tr>
    </thead>
    <tbody>
      <% @monthly_totals.sort.reverse.each do |month, total| %>
        <tr class="border-b border-gray-100 dark:border-gray-700">
          <td class="px-2 py-1"><%= month %></td>
          <td class="px-2 py-1"><%= number_to_currency(total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="m-5 border-t pt-8">
  <h2 class="mb-2 text-lg font-bold text-gray-800">🏥 <%= t('.sick_days') %></h2>
  <div class="overflow-x-auto border rounded-lg shadow-sm">
    <table class="min-w-full text-left text-sm font-light">
      <thead class="bg-gray-100 dark:bg-gray-700 font-medium border-b">
        <tr>
          <th class="px-4 py-2">📅 <%= t('.period') %></th>
          <th class="px-4 py-2 font-bold">💰 <%= t('.total') %></th>
          <th class="px-4 py-2 text-red-600">📉 <%= t('.income_tax') %></th>
          <th class="px-4 py-2 text-red-600">🛡️ <%= t('.military_tax') %></th>
        </tr>
      </thead>
      <tbody>
        <% if @sick_days_summaries.any? %>
          <% @sick_days_summaries.each do |period, data| %>
            <tr class="border-b">
              <td class="px-4 py-2"><%= period&.strftime("%Y-%m") %></td>
              <td class="px-4 py-2"><%= number_to_currency(data[:total]) %></td>
              <td class="px-4 py-2 text-red-500"><%= number_to_currency(data[:pdfo]) %></td>
              <td class="px-4 py-2 text-red-500"><%= number_to_currency(data[:military]) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-500 italic"><%= t('.no_sick_days') %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4 flex gap-2">
    <%= link_to t('.view_all'), employee_sick_days_path(@employee), class: "text-blue-600 underline" %>
    <%= link_to t('.add'), new_employee_sick_day_path(@employee), class: "text-green-600 underline" %>
  </div>
</div>

<div class="m-5 border-t pt-8">
  <h2 class="mb-2 text-lg font-bold text-gray-800">🏖️ <%= t('.vacations') %></h2>
  <div class="overflow-x-auto border rounded-lg shadow-sm">
    <table class="min-w-full text-left text-sm font-light">
      <thead class="bg-gray-100 dark:bg-gray-700 font-medium border-b">
        <tr>
          <th class="px-4 py-2">📅 <%= t('.period') %></th>
          <th class="px-4 py-2 font-bold">💰 <%= t('.vacation_amount') %></th>
          <th class="px-4 py-2 text-red-600">📉 <%= t('.income_tax') %></th>
          <th class="px-4 py-2 text-red-600">🛡️ <%= t('.military_tax') %></th>
        </tr>
      </thead>
      <tbody>
        <% if @vacations.any? %>
          <% @vacations.each do |vacation| %>
            <tr class="border-b">
              <td class="px-4 py-2"><%= vacation.period&.strftime("%Y-%m-%d") %></td>
              <td class="px-4 py-2"><%= number_to_currency(vacation.vacation_amount) %></td>
              <td class="px-4 py-2 text-red-500"><%= number_to_currency(vacation.pdfo_amount) %></td>
              <td class="px-4 py-2 text-red-500"><%= number_to_currency(vacation.military_amount) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-500 italic"><%= t('.no_vacations') %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4 flex gap-2">
    <%= link_to t('.view_all'), employee_vacations_path(@employee), class: "text-blue-600 underline" %>
    <%= link_to t('.add'), new_employee_vacation_path(@employee), class: "text-green-600 underline" %>
  </div>
</div>
