<p>
  <div class="mb-4">
    <%= link_to 'Add a new employee', new_employee_path, class: 'text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800', data: { turbo_frame: dom_id(Employee.new) } %>
  </div>
</p>
<div class="m-5">
  <div class="mb-6">
    <%= search_form_for @q, url: employees_path, method: :get, class: "" do |f| %>
      <div class="flex space-x-2">
        <%= f.label :id_code_eq, "ID Code" %>
        <%= f.search_field :id_code_eq, class: "border rounded p-1" %>

        <%= f.label :last_name_cont, "Last Name" %>
        <%= f.search_field :last_name_cont, class: "border rounded p-1" %>

        <%= f.label :first_name_cont, "First Name" %>
        <%= f.search_field :first_name_cont, class: "border rounded p-1" %>

        <%= f.submit "Search", class: "px-3 py-1 bg-blue-700 text-white rounded" %>
      </div>
    <% end %>
  </div>
</div>
<div class="m-5">
  <%= turbo_frame_tag "employees_list" do %>
    <div class="grid grid-cols-6 gap-x-3 border-b border-gray-200 font-bold bg-gray-300 dark:bg-gray-700">
      <div class="px-2 py-2"><%= sort_link(@q, :id_code, "ID") %></div>
      <div class="px-2 py-2"><%= sort_link(@q, :last_name, "Last Name") %></div>
      <div class="px-2 py-2"><%= sort_link(@q, :first_name, "First Name") %></div>
      <div class="px-2 py-2"><%= sort_link(@q, :patronic_name, "Patronic Name") %></div>
      <div class="px-2 py-2">Actions</div>
    </div>

    <%= render partial: 'employee', collection: @employees, as: :employee %>
  <% end %>
</div>

<p>
  <%= link_to 'Home Page', home_pages_path, class: 'text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800' %>
</p>
