<div class="m-5">
  <nav class="mb-4">
    <%= link_to "← Назад до працівника", employee_path(@employee), class: "text-blue-600 hover:underline text-sm" %>
  </nav>

  <h2 class="text-xl font-bold mb-6 text-gray-800 border-b pb-2">
    Редагувати відпустку: <%= @employee.last_name %> <%= @employee.first_name %>
  </h2>

  <%= render 'form', employee: @employee, vacation: @vacation %>

  <%= link_to "Видалити", employee_vacation_path(@employee, @vacation), data: { turbo_method: :delete, turbo_confirm: "Ви впевнені?" }, class: "text-red-600 hover:text-red-900 ml-4" %>
</div>
