<%= turbo_frame_tag dom_id(employee) do %>
  <div class="grid grid-cols-6 gap-x-3 border-b border-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800">
    <div class="px-2 py-2"><%= employee.id_code %></div>
    <div class="px-2 py-2"><%= employee.last_name %></div>
    <div class="px-2 py-2"><%= employee.first_name %></div>
    <div class="px-2 py-2"><%= employee.patronic_name %></div>
    <div class="px-2 py-2 flex space-x-2"> <!-- Встановлюємо flex для розташування кнопок в один рядок -->
      <%= link_to "Edit", edit_employee_path(employee), class: "px-3 py-1 text-xs font-medium text-center inline-flex items-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800", data: { turbo_frame: dom_id(employee) } %>
      <%= link_to "Show", employee_path(employee), class: "px-3 py-1 text-xs font-medium text-center inline-flex items-center text-white bg-green-700 rounded-lg hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800", data: { turbo: :false } %>
      <%= link_to 'Delete', employee_path(employee), class: 'px-3 py-1 text-xs font-medium text-center inline-flex items-center text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800', data: { turbo_method: :delete } %>
    </div>
  </div>
<% end %>

