<div class="m-5">
  <nav class="mb-4">
    <%= link_to t('vacations.edit.back'), employee_path(@employee), class: "text-blue-600 hover:underline text-sm" %>
  </nav>

  <h2 class="text-xl font-bold mb-6 text-gray-800 border-b pb-2">
    <%= t('vacations.edit.title', name: "#{@employee.last_name} #{@employee.first_name}") %>
  </h2>

  <%= render 'form', employee: @employee, vacation: @vacation %>

  <%= link_to t('vacations.edit.delete'), employee_vacation_path(@employee, @vacation), data: { turbo_method: :delete, turbo_confirm: t('vacations.edit.confirm_delete') }, class: "btn btn-danger btn-xs font-semibold rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 mt-4" %>
</div>
