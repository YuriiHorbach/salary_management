<%= turbo_frame_tag dom_id(department) do %>
  <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
    <%= link_to department.name, department_path(department), data: { turbo: false }, class: "hover:underline text-gray-600 font-semibold" %>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      <%= t('departments.card.employees') %>:
      <span id="department_<%= department.id %>_employee_count" class="font-semibold text-gray-900 dark:text-white">
        <%= employee_counts.fetch(department.id, 0) %>
      </span>
    </p>
    <div class="flex justify-between items-center mt-4">
      <%= link_to t('departments.card.edit'), edit_department_path(department), class: "mx-2 text-blue-600 hover:text-blue-800" %>
    </div>
  </div>
<% end %>
