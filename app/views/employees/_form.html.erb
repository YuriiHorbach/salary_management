<%= turbo_frame_tag dom_id(@employee) do %>
  <%= form_with model: @employee, local: false, class:'m-5 max-w-sm mx-auto border-4 p-3 rounded-lg' do |form| %>
    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :id_code %>
      </div>
      <div class="">
        <%= form.text_field :id_code, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :last_name %>
      </div>
      <div class="">
        <%= form.text_field :last_name, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
          <%= form.label :first_name %>
      </div>
      <div class="">
        <%= form.text_field :first_name, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :patronic_name %>

      </div>
      <div class="">
        <%= form.text_field :patronic_name, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :children_count %>

      </div>
      <div class="">
        <%= form.text_field :children_count, min: 0, autofocus: true, class:"p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :chaes, t('.chaes') %>

      </div>
      <div>
        <%= form.check_box :chaes, { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" }, "1", "0" %>
      </div>
    </div>

    <div class="mb-5">
    <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
      <%= form.label :contract, t('.contract') %>

    </div>
    <div>
      <%= form.check_box :contract, { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" }, "1", "0" %>
    </div>
  </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :disability_group, t('.disability_group') %>

      </div>
      <div>
        <%= form.select :disability_group,
                          [[t('.disability_options.none'), 0],
                           [t('.disability_options.group_1'), 1],
                           [t('.disability_options.group_2'), 2],
                           [t('.disability_options.group_3'), 3],
                           [t('.disability_options.low_income'), 4]],
                          {},
                          { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" } %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :territory_sign_id, t('.territory_sign') %>

      </div>
      <div>
        <%= form.collection_select :territory_sign_id,
                          @territory_signs,
                          :id, :name,
                          { include_blank: t('.select_brigade') },
                          { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" } %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :account_book_id, t('.account_book_code') %>

      </div>
      <div>
        <%= form.collection_select :account_book_id,
                          @account_books,
                          :id, :code,
                          { include_blank: t('.no_book') },
                          { class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" } %>
      </div>
    </div>

    <div class="mb-5">
      <div class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
        <%= form.label :page_number %>

      </div>
      <div>
        <%= form.text_field :page_number,
                            placeholder: t('.page_number_placeholder'),
                            class: "p-1 cursor-pointer border-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
        <p class="mt-1 text-xs text-gray-500"><%= t('.page_number_hint') %></p>
        <% if form.object.errors[:page_number].any? %>
          <p class="mt-1 text-xs text-red-600">
            <%= form.object.errors.full_messages_for(:page_number).first %>
          </p>
        <% end %>
      </div>
    </div>

    <div class="mt-3">
      <%= form.submit t('.submit'), class: "btn btn-primary px-3 py-2 text-xs font-medium text-center inline-flex items-center" %>
      <%= link_to t('.cancel'), employees_path, class: "btn btn-secondary px-3 py-2 text-xs font-medium text-center inline-flex items-center" %>
    </div>
  <% end %>
<% end %>
