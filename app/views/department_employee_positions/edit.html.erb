<div class="m-5">
  <h1 class="text-2xl font-semibold text-gray-800 mb-1">Посади працівника</h1>
  <p class="text-sm text-gray-600 mb-6">
    <%= @employee.full_name %> — <%= @department.name %>
  </p>

  <div class="mb-6 bg-white p-4 rounded-xl shadow-sm border border-gray-200">
    <h2 class="text-base font-semibold text-gray-800 mb-3">Посади працівника</h2>

    <% if @assigned_positions.any? %>
      <ul class="space-y-2">
        <% @assigned_positions.each do |position| %>
          <li id="assigned_position_<%= position.id %>"
              class="flex items-center justify-between gap-3 rounded-lg bg-gray-50 px-3 py-2">
            <span class="text-sm text-gray-800"><%= position.position_name %></span>

            <div class="flex items-center gap-3">
              <%= link_to '✏️ Редагувати',
                          edit_department_employee_positions_path(department_id: @department.id,
                                                                  employee_id: @employee.id,
                                                                  position_id: position.id,
                                                                  anchor: "position_#{position.id}"),
                          class: "text-blue-600 hover:underline text-xs",
                          title: "Редагувати посаду",
                          data: { turbo: false } %>
              <%= link_to '❌ Видалити',
                          department_employee_positions_path(department_id: @department.id,
                                                             employee_id: @employee.id,
                                                             position_id: position.id),
                          data: { turbo_method: :delete,
                                  turbo_confirm: "Видалити посаду «#{position.position_name}»?" },
                          class: "text-red-500 hover:text-red-700 text-xs",
                          title: "Видалити посаду" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">У працівника ще немає посад у цьому підрозділі.</p>
    <% end %>
  </div>

  <%= form_with url: department_employee_positions_path(department_id: @department.id, employee_id: @employee.id),
                method: :patch, local: true,
                class: "bg-gray-50 p-4 rounded-xl shadow-sm border border-gray-200" do |form| %>
    <p class="text-sm font-medium text-gray-700 mb-3">Оберіть посади в цьому підрозділі</p>

    <% if @positions.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
        <% @positions.each do |position| %>
          <label id="position_label_<%= position.id %>"
                 class="inline-flex items-center gap-2 bg-white border border-gray-200 rounded-lg px-3 py-2 cursor-pointer hover:bg-gray-100 <%= 'ring-2 ring-blue-500' if @highlighted_position_id == position.id %>">
            <%= check_box_tag 'position_ids[]', position.id, @selected_position_ids.include?(position.id),
                              id: "position_#{position.id}",
                              class: "w-4 h-4 text-blue-600 border-gray-300 rounded cursor-pointer" %>
            <span class="text-sm text-gray-800"><%= position.position_name %></span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">
        У цьому підрозділі ще немає посад. Додайте посаду до довідника підрозділу.
      </p>
    <% end %>

    <p class="text-xs text-gray-500 mt-3">
      Якщо не обрати жодної посади, працівник залишиться в підрозділі без посади.
    </p>

    <div class="mt-4 flex items-center gap-3">
      <%= form.submit "Зберегти", class: "btn btn-primary px-4 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
      <%= link_to 'Назад', department_path(@department), class: "text-blue-600 hover:underline text-sm" %>
    </div>
  <% end %>

  <div class="mt-6 bg-white p-4 rounded-xl shadow-sm border border-gray-200">
    <h2 class="text-base font-semibold text-gray-800 mb-1">Додати посаду до підрозділу</h2>
    <p class="text-xs text-gray-500 mb-3">
      Нову посаду буде додано до довідника «<%= @department.name %>». Після створення вона з’явиться у списку вище.
    </p>

    <%= form_with url: department_positions_path(@department), method: :post, local: true, scope: :position,
                  class: "flex flex-col sm:flex-row sm:items-end gap-3" do |form| %>
      <%= hidden_field_tag :employee_id, @employee.id %>

      <div class="flex flex-col flex-1">
        <%= form.label :position_name, "Назва посади", class: "text-xs font-bold text-gray-600 mb-1" %>
        <%= form.text_field :position_name, required: true,
                            class: "border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" %>
      </div>

      <%= form.submit "Додати посаду", class: "btn btn-primary px-4 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </div>
</div>
