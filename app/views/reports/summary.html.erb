<% content_for :title, "Зведений звіт (Pivot)" %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Зведений звіт по зарплатах (Pivot)</h1>

  <%= form_with url: summary_reports_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :period, "Період", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.month_field :period, value: @result[:period].strftime('%Y-%m'),
          class: "border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-900" %>
    </div>
    <%= form.submit "Показати", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-2 px-4 rounded" %>
  <% end %>

  <%= link_to "Експорт CSV",
      summary_reports_path(format: :csv, period: @result[:period].strftime('%Y-%m')),
      class: "bg-green-600 hover:bg-green-700 text-white text-sm font-bold py-2 px-4 rounded",
      data: { turbo: false } %>
</div>

<div class="overflow-x-auto">
  <table class="min-w-full border-collapse border border-gray-300">
    <thead class="bg-gray-100 font-bold">
      <tr>
        <th class="border border-gray-300 px-3 py-2 text-left text-sm whitespace-nowrap">Бригада</th>
        <th class="border border-gray-300 px-3 py-2 text-left text-sm whitespace-nowrap">Книга</th>
        <% Reports::SalarySummaryQuery::COLUMN_KEYS.each do |key| %>
          <th class="border border-gray-300 px-3 py-2 text-right text-sm whitespace-nowrap"><%= Reports::SalarySummaryQuery::COLUMN_LABELS[key] %></th>
        <% end %>
      </tr>
    </thead>

    <tbody class="divide-y divide-gray-200">
      <% @result[:brigades].each do |brigade_name, brigade_data| %>
        <% brigade_data[:books].each do |book_code, book_row| %>
          <tr class="bg-white">
            <td class="border border-gray-300 px-3 py-2 text-sm font-medium"><%= brigade_name %></td>
            <td class="border border-gray-300 px-3 py-2 text-sm pl-8"><%= book_code %></td>
            <% Reports::SalarySummaryQuery::COLUMN_KEYS.each do |key| %>
              <td class="border border-gray-300 px-3 py-2 text-right text-sm"><%= "%.2f" % (book_row[key] || 0) %></td>
            <% end %>
          </tr>
        <% end %>

        <tr class="bg-gray-100 font-bold">
          <td class="border border-gray-300 px-3 py-2 text-sm" colspan="2"><%= brigade_name %> — Підсумок</td>
          <% Reports::SalarySummaryQuery::COLUMN_KEYS.each do |key| %>
            <td class="border border-gray-300 px-3 py-2 text-right text-sm"><%= "%.2f" % (brigade_data[:total][key] || 0) %></td>
          <% end %>
        </tr>
      <% end %>

      <tr class="bg-gray-200 font-bold">
        <td class="border border-gray-300 px-3 py-2 text-sm" colspan="2">Всього</td>
        <% Reports::SalarySummaryQuery::COLUMN_KEYS.each do |key| %>
          <td class="border border-gray-300 px-3 py-2 text-right text-sm"><%= "%.2f" % (@result[:grand_total][key] || 0) %></td>
        <% end %>
      </tr>
    </tbody>
  </table>
</div>

<% if @result[:brigades].empty? %>
  <div class="mt-4 text-gray-500">Даних для звіту не знайдено.</div>
<% end %>
