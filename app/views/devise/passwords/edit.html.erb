<h2 class="text-3xl font-bold text-center text-gray-700 mb-6"><%= t('devise_views.passwords.edit_title') %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "max-w-md mx-auto" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="mb-4">
    <%= f.label :password, t('devise_views.passwords.new_password'), class: "block text-sm font-medium text-gray-700" %>
    <% if @minimum_password_length %>
      <em class="text-sm text-gray-500">(<%= t('devise_views.min_chars', count: @minimum_password_length) %>)</em>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "mt-1 p-2 w-full border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="mb-4">
    <%= f.label :password_confirmation, t('devise_views.passwords.confirm_password'), class: "block text-sm font-medium text-gray-700" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 p-2 w-full border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="mt-4">
    <%= f.submit t('devise_views.passwords.submit'), class: "btn btn-primary btn-xs w-full p-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
