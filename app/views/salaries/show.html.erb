<h1 class="text-2xl font-bold mb-4"><%= t('salaries.show.title') %></h1>
<%= turbo_frame_tag dom_id(@salary) do %>
  <div class="bg-white shadow rounded-lg p-6 space-y-4">
    <div>
      <strong class="text-gray-700"><%= t('salaries.show.salary') %>:</strong>
      <span><%= @salary_record&.salary %></span>
      <span><%= @salary_record&.salary %></span>
    </div>
    <div>
      <strong class="text-gray-700"><%= t('salaries.show.paid_on') %>:</strong>
      <span><%= @salary_record&.paid_on %></span>
    </div>
    <div>
      <strong class="text-gray-700"><%= t('salaries.show.notes') %>:</strong>
      <p class="text-gray-600"><%= @salary_record&.notes %></p>
    </div>
  </div>
<% end %>

<div class="mt-4">
  <% if @salary_record %>
    <%= link_to t('salaries.show.edit'), edit_employee_salary_path(@employee, @salary_record), class: 'btn btn-primary btn-xs rounded' %>
  <% end %>
  <%= link_to t('salaries.show.back'), employee_salaries_path(@employee), class: 'ml-2 text-blue-500 hover:underline' %>
</div>
