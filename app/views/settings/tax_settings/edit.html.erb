<% content_for :title, t('settings.tax_settings.edit.title') %>

<h1 class="text-2xl font-bold mb-6"><%= t('settings.tax_settings.edit.title') %></h1>

<div class="mb-6">
  <%= link_to t('settings.tax_settings.edit.back'), settings_root_path,
              class: "text-gray-600 hover:text-blue-600 text-sm font-medium" %>
</div>

<div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 max-w-2xl">
  <%= form_with model: @tax_setting, url: settings_tax_settings_path, method: :patch, class: "space-y-6" do |f| %>
    <% if @tax_setting.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold"><%= t('settings.tax_settings.edit.errors') %></strong>
        <ul class="list-disc list-inside mt-1">
          <% @tax_setting.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :income_rate, t('settings.tax_settings.edit.income_rate'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :income_rate, step: :any, min: 0,
                           class: "block w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
        <p class="mt-1 text-xs text-gray-500"><%= t('settings.tax_settings.edit.income_hint') %></p>
      </div>

      <div>
        <%= f.label :military_rate, t('settings.tax_settings.edit.military_rate'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :military_rate, step: :any, min: 0,
                           class: "block w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
        <p class="mt-1 text-xs text-gray-500"><%= t('settings.tax_settings.edit.military_hint') %></p>
      </div>

      <div>
        <%= f.label :gran_dohid_uah, t('settings.tax_settings.edit.gran_dohid'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :gran_dohid_uah, step: :any, min: 0,
                           class: "block w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :psp_uah, t('settings.tax_settings.edit.psp'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :psp_uah, step: :any, min: 0,
                           class: "block w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div class="flex gap-3 pt-4 border-t">
      <%= f.submit t('settings.tax_settings.edit.save'), class: "btn btn-primary px-6 py-2 rounded-md text-sm font-semibold" %>
      <%= link_to t('settings.tax_settings.edit.cancel'), settings_root_path,
                  class: "bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-2 rounded-md text-sm font-medium" %>
    </div>
  <% end %>
</div>
