<% content_for :title, t('reports.detailed.title') %>

<h1 class="text-2xl font-bold mb-6"><%= t('reports.detailed.title') %></h1>

<%= render 'shared/report_filters',
      url: detailed_reports_path,
      scope: 'reports.detailed',
      period_value: @period_value,
      departments: @departments,
      positions: @positions,
      brigades: @brigades,
      account_book_codes: @account_book_codes,
      reset_path: detailed_reports_path,
      turbo_frame: 'detailed_report_table' %>

<div class="mb-6 rounded-lg border border-gray-200 bg-gray-50 p-4">
  <p class="mb-3 text-sm text-gray-600"><%= t('reports.detailed.export_period_hint') %></p>

  <%= render 'detailed_export_form' %>
</div>

<%= turbo_frame_tag "detailed_report_table" do %>
  <%= render 'shared/pagination',
        pagy: @pagy,
        pagination_id: 'detailed_report_pagination_top',
        margin_class: 'mb-4' %>

  <div class="overflow-x-auto">
    <table class="min-w-full border-collapse border border-gray-300">
      <thead class="bg-gray-100 font-bold sticky top-0">
        <tr>
          <% Reports::EmployeeDetailedQuery::COLUMN_LABELS.each_key do |key| %>
            <% alignment = Reports::EmployeeDetailedQuery::TEXT_COLUMNS.include?(key) ? 'text-left' : 'text-right' %>
            <th class="border border-gray-300 px-3 py-2 <%= alignment %> text-sm whitespace-nowrap">
              <%= sort_link(@q, key, t("reports.detailed_columns.#{key}"),
                    class: "hover:text-blue-700 hover:underline",
                    page: nil,
                    commit: nil) %>
            </th>
          <% end %>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-200">
        <% if @employees.any? %>
          <% @employees.each do |emp| %>
            <tr class="bg-white">
              <% Reports::EmployeeDetailedQuery::COLUMN_LABELS.each_key do |key| %>
                <td class="<%= detailed_report_cell_class(key) %>">
                  <% if key == :page_number %>
                    <%= render 'reports/page_numbers/cell', row: emp %>
                  <% else %>
                    <%= detailed_report_cell_value(key, emp) %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>

          <% column_keys = Reports::EmployeeDetailedQuery::COLUMN_LABELS.keys %>
          <% text_columns = Reports::EmployeeDetailedQuery::TEXT_COLUMNS %>
          <% leading_text_keys = column_keys.take_while { |key| text_columns.include?(key) } %>
          <% trailing_text_keys = column_keys.select { |key| text_columns.include?(key) } - leading_text_keys %>
          <% numeric_keys = column_keys - text_columns %>
          <tr class="bg-gray-100 font-bold">
            <td class="border border-gray-300 px-3 py-2 text-sm" colspan="<%= leading_text_keys.size %>"><%= t('reports.detailed.total') %></td>
            <% numeric_keys.each do |key| %>
              <td class="<%= detailed_report_cell_class(key, emphasize: false) %>"><%= number_with_precision(@result[:totals][key], precision: 2) %></td>
            <% end %>
            <% trailing_text_keys.each do |key| %>
              <td class="<%= detailed_report_cell_class(key, emphasize: false) %>"></td>
            <% end %>
          </tr>
        <% else %>
          <tr>
            <td colspan="<%= Reports::EmployeeDetailedQuery::COLUMN_LABELS.size %>" class="px-6 py-4 text-center text-sm text-gray-500">
              <%= t('reports.detailed.empty') %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render 'shared/pagination',
        pagy: @pagy,
        pagination_id: 'detailed_report_pagination_bottom',
        margin_class: 'mt-4' %>
<% end %>
