# frozen_string_literal: true

require 'benchmark'
require 'fileutils'

# Read-path benchmarks used to compare report performance before and after
# correctness or query-count changes on the agent database.
module AgentBenchmark
  module_function

  # Builds the same salary relation as ReportsController#index for a month.
  #
  # @param period [Date] any date inside the target month
  # @return [ActiveRecord::Relation<Salary>]
  def salary_report_relation(period)
    query = Salary.ransack(by_month: period.month, by_year: period.year)

    query.result
         .by_month(period.month)
         .by_year(period.year)
  end

  # Measures the total-building part of ReportsController#index.
  #
  # @param period [Date]
  # @return [Array(Hash, Hash)] overall totals and department totals
  def salary_report_totals(period)
    service = SalaryReportService.new(salary_report_relation(period))

    [service.call, service.department_totals]
  end

  # Compares plain and distinct sums of salary amounts for the period.
  #
  # @param period [Date]
  # @return [Array(Integer, Integer)] plain sum and SUM(DISTINCT) sum
  def amount_discrepancy(period)
    Salary.where(period: period.all_month)
          .pick(
            Arel.sql('COALESCE(SUM(salaries.amount_cents), 0)'),
            Arel.sql('COALESCE(SUM(DISTINCT salaries.amount_cents), 0)')
          ) || [0, 0]
  end
end

namespace :agent do
  desc 'Benchmark reports/search/CSV and append results to docs/performance-baseline.md. Agent DB only.'
  task benchmark: :environment do
    AgentScale.ensure_agent_database!

    period = AgentScale.parse_period(ENV.fetch('PERIOD', Date.current.strftime('%Y-%m')))
    date_from = ENV.fetch('DATE_FROM', (period - 11.months).to_s)
    date_to = ENV.fetch('DATE_TO', period.end_of_month.to_s)
    search_term = ENV['SEARCH_TERM'].presence || Employee.order(:id).pick(:last_name).to_s[0, 3]
    search_term = 'Шев' if search_term.blank?
    label = ENV['LABEL'].presence

    detailed_params = { date_from: date_from, date_to: date_to }
    summary_params = { period: period.strftime('%Y-%m') }

    results = []
    results << AgentScale.measure('Salary report totals (C1)') do
      AgentBenchmark.salary_report_totals(period)
    end
    results << AgentScale.measure('Detailed report (all rows)') do
      Reports::EmployeeDetailedQuery.new(detailed_params).call
    end
    results << AgentScale.measure('Summary report') do
      Reports::SalarySummaryQuery.new(summary_params).call
    end
    results << AgentScale.measure("Employee search (#{search_term})") do
      Employee.search_by_id_code_or_name(search_term).to_a
    end
    results << AgentScale.measure('Detailed CSV export (query + build)') do
      result = Reports::EmployeeDetailedQuery.new(detailed_params).call
      Reports::EmployeeDetailedCsvExporter.new(result).call
    end

    plain_sum, distinct_sum = AgentBenchmark.amount_discrepancy(period)

    header = format('%-40<label>s %10<seconds>s %10<sql>s', label: 'Operation', seconds: 'Seconds', sql: 'SQL')
    puts header
    results.each do |result_label, seconds, sql|
      puts format('%-40<label>s %10.3<seconds>f %10<sql>d',
                  label: result_label, seconds: seconds, sql: sql)
    end
    puts format(
      'C1 amount totals for %<period>s: SUM=%<plain>d, SUM(DISTINCT)=%<distinct>d, difference=%<difference>d',
      period: period.strftime('%Y-%m'), plain: plain_sum, distinct: distinct_sum,
      difference: plain_sum - distinct_sum
    )

    path = Rails.root.join('docs/performance-baseline.md')
    FileUtils.mkdir_p(path.dirname)
    File.write(path, "# Performance Baseline\n\nGenerated by `bin/rails agent:benchmark`.\n") unless File.exist?(path)

    File.open(path, 'a') do |file|
      file.puts "\n## #{Time.current.iso8601}#{label ? " — #{label}" : ''}"
      file.puts
      file.puts "- Environment: `#{Rails.env}`"
      file.puts "- Database: `#{ActiveRecord::Base.connection_db_config.database}`"
      file.puts "- Rails: `#{Rails.version}` / Ruby: `#{RUBY_VERSION}`"
      file.puts "- Dataset: employees=#{Employee.count}, salaries=#{Salary.count}, " \
                "vacations=#{Vacation.count}, sick_days=#{SickDay.count}, " \
                "period_incomes=#{EmployeePeriodIncome.count}"
      file.puts "- Period: #{period.strftime('%Y-%m')}, date range: #{date_from}..#{date_to}, " \
                "search: `#{search_term}`"
      file.puts "- C1 amount totals: SUM=#{plain_sum}, SUM(DISTINCT)=#{distinct_sum}, " \
                "difference=#{plain_sum - distinct_sum}"
      file.puts
      file.puts '| Operation | Time (s) | SQL queries |'
      file.puts '|---|---:|---:|'
      results.each do |result_label, seconds, sql|
        file.puts "| #{result_label} | #{format('%<seconds>.3f', seconds: seconds)} | #{sql} |"
      end
    end

    puts "\nBaseline appended to #{path}"
  end
end
