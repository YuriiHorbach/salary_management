<%= turbo_frame_tag dom_id(@salary) do %>
  <div class="space-y-4">
    <%= form_with model: [@employee, @salary], local: true, class: 'm-5 mx-auto border-4 p-3 rounded-lg' do |form| %>
    <%= form.hidden_field :department_id %>
  <% if @salary.errors.any? %>
    <p class="text-sm text-red-600"><%= @salary.errors.full_messages.to_sentence %></p>
  <% end %>
  <div class="mb-5">
    <div class="grid grid-cols-6 gap-x-3">
      <div class="col-span-2">
        <%= form.label :amount, class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :amount, value: (@salary.amount_cents || 0) / 100.0, step: 0.01,
                              class: "p-1 cursor-pointer border-b-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
      <div class="col-span-2">
        <%= form.label :period, t('salaries.form.period'), class: "block text-sm font-medium text-gray-700" %>
        <%= form.month_field :period, value: @salary.month, class:"p-1 cursor-pointer border-b-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" %>
      </div>
      <div class="col-span-2">
        <%= form.label :position_id, t('salaries.form.position'), class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :position_id, @positions || [], :id, :position_name,
            { include_blank: t('salaries.form.no_position') },
            { class: "w-full p-1 cursor-pointer border-b-2 outline-none focus:border-4 focus:border-gray-500 rounded-lg" } %>
      </div>
    </div>
  </div>
  <div class="mt-4">
    <%= form.submit t('salaries.form.submit'), class: "btn btn-primary btn-xs rounded hover:bg-blue-600" %>
  </div>
<% end %>

  </div>
<% end %>


<%= link_to t('salaries.form.back'), employee_salaries_path(@employee), class: 'mt-1 inline-block text-blue-500 hover:underline' %>
