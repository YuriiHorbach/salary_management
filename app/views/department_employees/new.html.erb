<h3>Add Employees to <%= @department.name %></h3>

<div class="m-5 bg-gray-50 p-4 rounded-xl shadow-sm border border-gray-200">
  <%= search_form_for @q, url: new_department_employee_path(department_id: @department.id), method: :get do |f| %>
    <%= hidden_field_tag :department_id, @department.id %>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">

      <div class="flex flex-col">
        <%= f.label :id_code_eq, "ID-code", class: "text-xs font-bold text-gray-600 mb-1" %>
        <%= f.search_field :id_code_eq, class: "border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" %>
      </div>

      <div class="flex flex-col">
        <%= f.label :last_name_cont, "Last name", class: "text-xs font-bold text-gray-600 mb-1" %>
        <%= f.search_field :last_name_cont, class: "border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" %>
      </div>

      <div class="flex flex-col">
        <%= f.label :first_name_cont, "First name", class: "text-xs font-bold text-gray-600 mb-1" %>
        <%= f.search_field :first_name_cont, class: "border border-gray-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" %>
      </div>

      <div class="flex items-center space-x-2 h-10">
        <%= f.submit "Submit 🔍", class: "btn btn-primary btn-xs flex-1 font-bold py-2 px-3 rounded-lg hover:bg-blue-800 cursor-pointer text-sm shadow-md" %>
        <%= link_to "Clear", new_department_employee_path(department_id: @department.id), class: "btn btn-secondary btn-xs flex-1 font-bold py-2 px-3 rounded-lg hover:bg-gray-800 cursor-pointer text-sm shadow-md" %>
      </div>

    </div>
  <% end %>
</div>

<%= form_with(url: department_employees_path, method: :post, local: true) do |form| %>
  <%= hidden_field_tag :department_id, @department.id %>

  <table class="min-w-full table-auto border-collapse border border-gray-200">
    <thead>
    <tr>
      <th class="px-4 py-2 border border-gray-300"><%= sort_link(@q, :id_code, "ID-code") %></th>
      <th class="px-4 py-2 border border-gray-300"><%= sort_link(@q, :last_name, "Last name") %></th>
      <th class="px-4 py-2 border border-gray-300"><%= sort_link(@q, :first_name, "First name") %></th>
      <th class="px-4 py-2 border border-gray-300"><%= sort_link(@q, :patronic_name, "Patronic name") %></th>
      <th class="px-4 py-2 border border-gray-300">Add</th>
    </tr>
    </thead>
    <tbody>
    <% @employees.each do |employee| %>
      <tr>
        <td class="px-4 py-2 border border-gray-300">
          <%= employee.id_code %>
        </td>
        <td class="px-4 py-2 border border-gray-300"><%= employee.last_name %></td>
        <td class="px-4 py-2 border border-gray-300"><%= employee.first_name %></td>
        <td class="px-4 py-2 border border-gray-300"><%= employee.patronic_name %></td>
        <td class="px-4 py-2 border border-gray-300"> <%= check_box_tag "employee_ids[]", employee.id, false, id: "employee_#{employee.id}" %></td>
      </tr>
    <% end %>
    </tbody>
  </table>

  <div class="mt-2">
    <%= form.submit "Add Employees", class: "btn btn-primary mt-4 px-4 py-2 rounded hover:bg-blue-700" %>
  </div>
<% end %>
