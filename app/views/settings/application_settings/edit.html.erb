<% content_for :title, t('settings.application_settings.edit.title') %>

<h1 class="text-2xl font-bold mb-6"><%= t('settings.application_settings.edit.title') %></h1>

<div class="mb-6">
  <%= link_to t('settings.application_settings.edit.back'), settings_root_path,
              class: "text-gray-600 hover:text-blue-600 text-sm font-medium" %>
</div>

<div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 max-w-2xl">
  <%= form_with model: @application_setting, url: settings_application_setting_path,
                method: :patch, class: "space-y-6" do |f| %>
    <% if @application_setting.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold"><%= t('settings.application_settings.edit.errors') %></strong>
        <ul class="list-disc list-inside mt-1">
          <% @application_setting.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :default_locale, t('settings.application_settings.edit.default_locale'),
                  class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :default_locale,
                   supported_locales.map { |locale| [t("locales.#{locale}"), locale] },
                   {},
                   class: "block w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
      <p class="mt-1 text-xs text-gray-500"><%= t('settings.application_settings.edit.hint') %></p>
    </div>

    <div class="flex gap-3 pt-4 border-t">
      <%= f.submit t('settings.application_settings.edit.save'),
                   class: "btn btn-primary px-6 py-2 rounded-md text-sm font-semibold" %>
      <%= link_to t('settings.application_settings.edit.cancel'), settings_root_path,
                  class: "bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-2 rounded-md text-sm font-medium" %>
    </div>
  <% end %>
</div>
