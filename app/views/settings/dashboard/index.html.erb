<% content_for :title, t('settings.dashboard.title') %>

<h1 class="text-2xl font-bold mb-6"><%= t('settings.dashboard.title') %></h1>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
    <h2 class="text-lg font-semibold mb-4 text-blue-700"><%= t('settings.dashboard.territory_title') %></h2>
    <p class="text-gray-600 mb-4"><%= t('settings.dashboard.territory_description') %></p>
    <div class="flex gap-2">
      <%= link_to t('settings.dashboard.add_brigade'), new_settings_territory_sign_path,
                  class: "btn btn-primary" %>
      <%= link_to t('settings.dashboard.view_all'), settings_territory_signs_path,
                  class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
    <h2 class="text-lg font-semibold mb-4 text-yellow-700"><%= t('settings.dashboard.taxes_title') %></h2>
    <p class="text-gray-600 mb-4"><%= t('settings.dashboard.taxes_description') %></p>
    <div class="flex gap-2">
      <%= link_to t('settings.dashboard.edit_taxes'), edit_settings_tax_settings_path,
                  class: "btn btn-primary" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
    <h2 class="text-lg font-semibold mb-4 text-green-700"><%= t('settings.dashboard.books_title') %></h2>
    <p class="text-gray-600 mb-4"><%= t('settings.dashboard.books_description') %></p>
    <div class="flex gap-2">
      <%= link_to t('settings.dashboard.add_book'), new_settings_account_book_path,
                  class: "btn btn-primary" %>
      <%= link_to t('settings.dashboard.view_all'), settings_account_books_path,
                  class: "btn btn-secondary" %>
    </div>
  </div>
</div>
