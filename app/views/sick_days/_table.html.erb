<div class="shadow-md rounded-lg overflow-hidden border border-gray-200">
  <div class="grid grid-cols-2 lg:grid-cols-5 bg-gray-100 font-bold text-gray-700 border-b border-gray-200">
    <div class="px-4 py-3"><%= t('sick_days.table.period') %></div>
    <div class="px-4 py-3 text-right"><%= t('sick_days.table.pfu') %></div>
    <div class="px-4 py-3 text-right"><%= t('sick_days.table.enterprise') %></div>
    <div class="px-4 py-3 text-right"><%= t('sick_days.table.total') %></div>
    <div class="px-4 py-3 text-center col-span-2 lg:col-span-1"><%= t('sick_days.table.actions') %></div>
  </div>

  <div class="bg-white divide-y divide-gray-200">
    <% sick_days.group_by(&:period).each do |period, days| %>
      <%= render partial: 'row', collection: days, as: :sd %>
      <%= render 'summary_row', period: period, summaries: sick_days_summaries %>
    <% end %>
  </div>
</div>
