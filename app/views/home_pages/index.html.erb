<% working_month = current_user.current_working_month %>

<main class="max-w-3xl mx-auto p-6 space-y-6">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Головна сторінка</h1>

  <% if working_month.present? %>
    <section class="rounded-lg border border-green-300 bg-green-50 p-4 text-green-900 dark:border-green-700 dark:bg-green-900/20 dark:text-green-100">
      <p class="font-semibold">
        Поточний робочий місяць: <%= working_month.strftime('%m.%Y') %>
      </p>
      <p class="mt-1 text-sm">
        Він автоматично підставлятиметься у форми додавання зарплат, відпускних і лікарняних.
      </p>
    </section>
  <% else %>
    <section class="rounded-lg border border-yellow-300 bg-yellow-50 p-4 text-yellow-900 dark:border-yellow-700 dark:bg-yellow-900/20 dark:text-yellow-100">
      <p class="font-semibold">Оберіть поточний робочий місяць</p>
      <p class="mt-1 text-sm">
        Він може не збігатися з календарним місяцем. Оберіть місяць, з яким ви зараз працюєте,
        щоб він автоматично підставлявся у форми додавання зарплат, відпускних і лікарняних.
      </p>
    </section>
  <% end %>

  <section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
    <%= form_with url: current_working_month_path, method: :patch, class: "flex flex-wrap items-end gap-4" do |form| %>
      <div>
        <%= form.label :current_working_month, "Поточний робочий місяць",
                       class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-200" %>
        <%= form.month_field :current_working_month,
                             value: (working_month || Date.current).strftime('%Y-%m'),
                             required: true,
                             class: "rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-900 dark:text-white" %>
      </div>

      <%= form.submit "Зберегти місяць",
                      class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
    <% end %>
  </section>

  <div>
    <%= link_to 'Departments', departments_path, class: "text-blue-600 hover:underline dark:text-blue-400" %>
  </div>
</main>
