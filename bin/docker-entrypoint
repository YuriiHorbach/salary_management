#!/bin/bash -e

# If running the rails server, rebuild Tailwind from the mounted sources and
# prepare the database before booting. The build must succeed first because the
# script runs with `set -e`.
if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  ./bin/rails tailwindcss:build
  ./bin/rails db:prepare
fi

exec "${@}"
