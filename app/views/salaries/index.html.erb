<% employee_name = "#{@employee.last_name} #{@employee.first_name} #{@employee.patronic_name}" %>

<h1 class="text-2xl font-bold mb-4"><%= link_to t('salaries.index.title', name: employee_name), employee_path(@employee) %></h1>

<div class="m-5 mb-6">
  <%= form_with url: employee_salaries_path(@employee), method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :period, t('salaries.index.period'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.month_field :period, value: (@period || Date.current).strftime('%Y-%m'),
          class: "border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-900" %>
    </div>
    <%= form.submit t('salaries.index.show'), class: "btn btn-primary btn-xs rounded-md font-medium transition shadow-sm" %>
    <% if @period.present? %>
      <%= link_to t('salaries.index.all_periods'), employee_salaries_path(@employee), class: "text-sm text-blue-600 hover:underline" %>
    <% end %>
  <% end %>
</div>

<% if @period_incomes.any? %>
  <div class="m-5 overflow-x-auto">
    <h2 class="text-lg font-semibold mb-2"><%= t('salaries.index.period_totals') %></h2>
    <% money = ->(cents) { number_to_currency(cents.to_i / 100.0) } %>
    <table class="min-w-full border-collapse text-sm">
      <thead class="bg-gray-100">
        <tr>
          <th class="border border-gray-300 px-2 py-2 text-left whitespace-nowrap"><%= t('salaries.index.headers.period') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.salary') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.salary_tax') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.salary_military') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.vacation') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.vacation_tax') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.vacation_military') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.sick') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.sick_tax') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.sick_military') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.total_income') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.total_taxes') %></th>
          <th class="border border-gray-300 px-2 py-2 text-right whitespace-nowrap"><%= t('salaries.index.headers.total_military') %></th>
        </tr>
      </thead>
      <tbody>
        <% @period_incomes.group_by(&:period).sort_by(&:first).reverse_each do |period, rows| %>
          <% by_type = rows.index_by(&:income_type) %>
          <% salary = by_type['salary'] %>
          <% vacation = by_type['vacation'] %>
          <% sick = by_type['sick_day'] %>
          <tr class="hover:bg-gray-50">
            <td class="border border-gray-300 px-2 py-2 whitespace-nowrap"><%= period.strftime('%m-%Y') %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(salary&.gross_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(salary&.income_tax_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(salary&.military_tax_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(vacation&.gross_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(vacation&.income_tax_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(vacation&.military_tax_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(sick&.gross_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(sick&.income_tax_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono"><%= money.call(sick&.military_tax_cents) %></td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono">
              <%= money.call((salary&.gross_cents.to_i) + (vacation&.gross_cents.to_i) + (sick&.gross_cents.to_i)) %>
            </td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono">
              <%= money.call((salary&.income_tax_cents.to_i) + (vacation&.income_tax_cents.to_i) + (sick&.income_tax_cents.to_i)) %>
            </td>
            <td class="border border-gray-300 px-2 py-2 text-right font-mono">
              <%= money.call((salary&.military_tax_cents.to_i) + (vacation&.military_tax_cents.to_i) + (sick&.military_tax_cents.to_i)) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%= render 'salaries/salary_totals_by_position' %>

<div class="m-5">
  <div class="grid grid-cols-12 gap-x-3 border-b border-gray-300 font-semibold text-sm">
    <div class="col-span-2 px-2 py-2"><%= t('salaries.index.amount') %></div>
    <div class="col-span-2 px-2 py-2"><%= t('salaries.index.period') %></div>
    <div class="col-span-3 px-2 py-2"><%= t('salaries.index.department') %></div>
    <div class="col-span-3 px-2 py-2"><%= t('salaries.index.position') %></div>
    <div class="col-span-2 px-2 py-2"><%= t('salaries.index.actions') %></div>
  </div>

  <%= turbo_frame_tag "new_salary" %>
  <%= render partial: 'salary', collection: @salaries, as: :salary %>

  <%= render 'shared/pagination',
             pagy: @pagy,
             pagination_id: 'salaries_pagination',
             margin_class: 'mt-4' %>
</div>

<% if @departments.any? %>
  <div class="m-5 mt-4 flex flex-wrap items-center gap-2">
    <span class="text-sm font-medium text-gray-700"><%= t('salaries.index.back_to_department') %></span>
    <% @departments.each do |department| %>
      <%= link_to department.name,
                  department_path(department, period: @period&.strftime('%Y-%m')),
                  class: "btn btn-primary btn-xs rounded" %>
    <% end %>
  </div>
<% else %>
  <%= link_to t('salaries.index.back_to_employee'), employee_path(@employee),
                                      class: "btn btn-primary btn-xs mt-4 rounded" %>
<% end %>

<div class = "mt-8">
  <%= link_to t('.back'), :back, class: "btn btn-primary px-3 py-1 text-xs font-medium text-center inline-flex items-center" %>
</div>
