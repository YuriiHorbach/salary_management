<div class="shadow-md rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700">
  <div class="grid grid-cols-5 bg-gray-100 dark:bg-gray-800 font-bold text-gray-700 dark:text-gray-200 border-b border-gray-200 dark:border-gray-700">
    <div class="px-4 py-3">Період</div>
    <div class="px-4 py-3 text-right">ФСС (ПФУ)</div>
    <div class="px-4 py-3 text-right">Підприємство</div>
    <div class="px-4 py-3 text-right">Разом</div>
    <div class="px-4 py-3 text-center">Дії</div>
  </div>

  <div class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-700">
    <% sick_days.group_by(&:period).each do |period, days| %>
      <%= render partial: 'row', collection: days, as: :sd %>
      <%= render 'summary_row', period: period, summaries: sick_days_summaries %>
    <% end %>
  </div>
</div>
