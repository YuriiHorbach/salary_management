<% if pagy.last > 1 %>
  <div id="<%= pagination_id %>" class="<%= margin_class %> flex flex-col sm:flex-row items-center justify-between gap-2 text-sm">
    <span class="text-gray-600"><%= t('pagination.page_of', page: pagy.page, last: pagy.last) %></span>
    <%== pagy.series_nav(
          anchor_string: 'class="inline-block mr-1 px-3 py-1 border border-gray-300 rounded hover:bg-gray-100"',
          querify: ->(params) { params.except!('commit', 'controller', 'action') }
        ) %>
  </div>
<% end %>
