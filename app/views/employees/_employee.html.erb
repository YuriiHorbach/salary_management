<%= turbo_frame_tag dom_id(employee) do %>
  <div class="grid grid-cols-9 gap-x-3 border border-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800">
    <div class="px-2 py-2 border-r border-gray-200"><%= employee.id_code %></div>
    <div class="px-2 py-2 border-r border-gray-200 whitespace-normal break-words"><%= employee.last_name %></div>
    <div class="px-2 py-2 border-r border-gray-200 whitespace-normal break-words"><%= employee.first_name %></div>
    <div class="px-2 py-2 border-r border-gray-200 whitespace-normal break-words"><%= employee.patronic_name %></div>
    <div class="px-2 py-2 border-r border-gray-200 text-right"><%= employee.children_count %></div>
    <div class="px-2 py-2 border-r border-gray-200 text-right"><%= employee.disability_group %></div>
    <div class="px-2 py-2 border-r border-gray-200 text-right"><%= employee.chaes %></div>
    <div class="px-2 py-2 border-r border-gray-200"><%= employee.territory_info %></div>
    <div class="px-2 py-2 border-r border-gray-200 flex flex-col space-y-1 items-stretch">

  <%= link_to "Show", employee_path(employee),
        class: "px-2 py-0.5 text-[10px] font-medium text-center text-white bg-green-700 rounded hover:bg-green-800 focus:outline-none dark:bg-green-600 dark:hover:bg-green-700",
        data: { turbo: :false } %>

  <%= link_to "Edit", edit_employee_path(employee),
        class: "px-2 py-0.5 text-[10px] font-medium text-center text-white bg-blue-700 rounded hover:bg-blue-800 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700",
        data: { turbo_frame: dom_id(employee) } %>

  <%= link_to 'Delete', employee_path(employee),
        class: 'px-2 py-0.5 text-[10px] font-medium text-center text-white bg-red-700 rounded hover:bg-red-800 focus:outline-none dark:bg-red-600 dark:hover:bg-red-700',
        data: { turbo_method: :delete } %>
</div>
  </div>
<% end %>

