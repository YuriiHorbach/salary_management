<%= turbo_frame_tag dom_id(@employee) do %>
  <div class="grid grid-cols-[8rem_1fr] gap-y-2 max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
    <div class="w-32 font-semibold text-gray-500">ID code</div>
    <div class="text-gray-900"><%= @employee.id_code %></div>

    <div class="w-32 font-semibold text-gray-500">Last name</div>
    <div class="text-gray-900"><%= @employee.last_name %></div>

    <div class="w-32 font-semibold text-gray-500">First name</div>
    <div class="text-gray-900"><%= @employee.first_name %></div>

    <div class="w-32 font-semibold text-gray-500">Patronic name</div>
    <div class="text-gray-900"><%= @employee.patronic_name %></div>

    <div class="px-2 py-2 flex space-x-2">
      <%= link_to "Edit", edit_employee_path(@employee), class: "px-3 py-1 text-xs font-medium text-center inline-flex items-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800", data: { turbo_frame: dom_id(@employee) } %>
    </div>
  </div>
<% end %>

<div class="m-5">
  <%= search_form_for @salary_q, as: :salary_q, url: employee_path(@employee), method: :get, html: {class: 'mb-4 flex flex-wrap gap-4 items-end'} do |f| %>
    <% input_classes = "border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-900" %>

    <div>
      <%= f.label :amount_cents_eq, 'Сума (коп)', class: "block text-sm font-medium mb-1" %>
      <%= f.search_field :amount_cents_eq, class: input_classes %>
    </div>

    <div>
      <%= f.label :by_year, 'Рік', class: "block text-sm font-medium mb-1" %>
      <%= f.select :by_year, options_for_select((2020..Date.today.year), params.dig(:salary_q, :by_year)), { include_blank: 'Всі роки' }, class: input_classes %>
    </div>

    <div>
      <%= f.label :department_id_eq, 'Підрозділ', class: "block text-sm font-medium mb-1" %>
      <%= f.select :department_id_eq, options_from_collection_for_select(@departments, 'id', 'name', params.dig(:salary_q, :department_id_eq)), { include_blank: 'Всі підрозділи' }, class: input_classes %>
    </div>

    <div>
      <%= f.submit 'Пошук зарплат', class: 'bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-md font-medium' %>
    </div>
  <% end %>
</div>

<div class="m-5">
  <h2 class="mt-8 mb-2 text-lg font-bold">Зарплати співробітника по підрозділах</h2>
  <table class="min-w-full text-left text-sm font-light text-surface dark:text-white border">
    <thead class="bg-gray-200 dark:bg-gray-700">
      <tr>
        <th class="px-2 py-1">
          <%= sort_link(@salary_q, :department_name, 'Підрозділ', default_order: :asc) %>
        </th>
        <th class="px-2 py-1">
          <%= sort_link(@salary_q, :amount_cents, 'Сума') %>
        </th>
        <th class="px-2 py-1">
          <%= sort_link(@salary_q, :paid_on, 'Дата виплати') %>
        </th>
      </tr>
    </thead>
    <tbody>
      <% if @employee_salaries.any? %>
        <% @employee_salaries.each do |department, salaries| %>
          <% salaries.each do |salary| %>
            <tr class="border-b border-gray-100 dark:border-gray-700">
              <td class="px-2 py-1"><%= department&.name || 'Без підрозділу' %></td>
              <td class="px-2 py-1"><%= number_to_currency(salary.amount) %></td>
              <td class="px-2 py-1"><%= salary.paid_on&.strftime('%d-%m-%Y') %></td>
            </tr>
          <% end %>
        <% end %>
      <% else %>
        <tr><td colspan="3" class="p-4 text-center text-gray-500 italic">Зарплат не знайдено</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="m-5">
  <h2 class="mt-8 mb-2 text-lg font-bold">Загальна зарплата по місяцях (підсумки)</h2>
  <table class="min-w-full text-left text-sm font-light text-surface dark:text-white border mb-8">
    <thead class="bg-gray-200 dark:bg-gray-700">
      <tr>
        <th class="px-2 py-1">Місяць</th>
        <th class="px-2 py-1">Сума</th>
      </tr>
    </thead>
    <tbody>
      <% @monthly_totals.sort.reverse.each do |month, total| %>
        <tr class="border-b border-gray-100 dark:border-gray-700">
          <td class="px-2 py-1"><%= month %></td>
          <td class="px-2 py-1"><%= number_to_currency(total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="m-5 border-t pt-8">
  <h2 class="mb-2 text-lg font-bold text-gray-800">🏥 Лікарняні (зведені)</h2>
  <div class="overflow-x-auto border rounded-lg shadow-sm">
    <table class="min-w-full text-left text-sm font-light">
      <thead class="bg-gray-100 dark:bg-gray-700 font-medium border-b">
        <tr>
          <th class="px-4 py-2">📅 Період</th>
          <th class="px-4 py-2 font-bold">💰 Разом</th>
          <th class="px-4 py-2 text-red-600">📉 ПДФО (18%)</th>
          <th class="px-4 py-2 text-red-600">🛡️ ВЗ (5%)</th>
        </tr>
      </thead>
      <tbody>
        <% if @sick_days_summaries.any? %>
          <% @sick_days_summaries.each do |period, data| %>
            <tr class="border-b">
              <td class="px-4 py-2"><%= period&.strftime("%Y-%m") %></td>
              <td class="px-4 py-2"><%= number_to_currency(data[:total]) %></td>
              <td class="px-4 py-2 text-red-500"><%= number_to_currency(data[:pdfo]) %></td>
              <td class="px-4 py-2 text-red-500"><%= number_to_currency(data[:military]) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-500 italic">Немає лікарняних</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4 flex gap-2">
    <%= link_to 'Переглянути всі', employee_sick_days_path(@employee), class: "text-blue-600 underline" %>
    <%= link_to 'Додати', new_employee_sick_day_path(@employee), class: "text-green-600 underline" %>
  </div>
</div>

<div class="m-5 border-t pt-8">
  <h2 class="mb-2 text-lg font-bold text-gray-800">🏖️ Відпускні</h2>
  <div class="overflow-x-auto border rounded-lg shadow-sm">
    <table class="min-w-full text-left text-sm font-light">
      <thead class="bg-gray-100 dark:bg-gray-700 font-medium border-b">
        <tr>
          <th class="px-4 py-2">📅 Період</th>
          <th class="px-4 py-2 font-bold">💰 Сума</th>
          <th class="px-4 py-2 text-red-600">📉 ПДФО</th>
          <th class="px-4 py-2 text-red-600">🛡️ ВЗ</th>
        </tr>
      </thead>
      <tbody>
        <% if @vacations.any? %>
          <% @vacations.each do |vacation| %>
            <tr class="border-b">
              <td class="px-4 py-2"><%= vacation.period&.strftime("%Y-%m-%d") %></td>
              <td class="px-4 py-2"><%= number_to_currency(vacation.vacation_amount_cents) %></td>
              <td class="px-4 py-2 text-red-500"><%= number_to_currency(vacation.income_tax_cents) %></td>
              <td class="px-4 py-2 text-red-500"><%= number_to_currency(vacation.military_tax_cents) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-500 italic">Немає відпускних</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4 flex gap-2">
    <%= link_to 'Переглянути всі', employee_vacations_path(@employee), class: "text-blue-600 underline" %>
    <%= link_to 'Додати', new_employee_vacation_path(@employee), class: "text-green-600 underline" %>
  </div>
</div>
