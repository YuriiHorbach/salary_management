<div class="overflow-x-auto shadow-md rounded-lg">
  <table class="min-w-full bg-white dark:bg-gray-900">
    <thead class="bg-gray-100 dark:bg-gray-800">
      <tr>
        <th class="px-4 py-2 text-left">Період</th>
        <th class="px-4 py-2 text-right">ФСС (ПФУ)</th>
        <th class="px-4 py-2 text-right">Підприємство</th>
        <th class="px-4 py-2 text-right">Разом</th>
        <th class="px-4 py-2 text-center">Дії</th>
      </tr>
    </thead>
    <tbody>
      <% @sick_days.group_by(&:period).each do |period, days| %>
        <% days.each do |sd| %>
          <tr class="border-b hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
            <%= turbo_frame_tag dom_id(sd), class: "contents" do %>
              <td class="px-4 py-2 text-sm text-gray-500"><%= sd.period&.strftime("%B %Y") %></td>
              <td class="px-4 py-2 text-right"><%= number_to_currency(sd.pfu_amount) %></td>
              <td class="px-4 py-2 text-right"><%= number_to_currency(sd.enterprise_amount) %></td>
              <td class="px-4 py-2 text-right font-medium"><%= number_to_currency(sd.total_amount) %></td>
              <td class="px-4 py-2 text-center">
                <%= link_to "✏️", edit_employee_sick_day_path(@employee, sd), class: "hover:scale-110 inline-block" %>
              </td>
            <% end %>
          </tr>
        <% end %>

        <tr class="bg-blue-50 dark:bg-blue-900/30 font-bold border-b-2 border-blue-200">
          <td class="px-4 py-2 text-blue-800 dark:text-blue-300 text-sm">РАЗОМ ЗА <%= period&.strftime("%m.%Y") %>:</td>
          <% summary = @sick_days_summaries[period] %>
          <td class="px-4 py-2 text-right text-blue-800"><%= number_to_currency(summary[:pfu]) if summary %></td>
          <td class="px-4 py-2 text-right text-blue-800"><%= number_to_currency(summary[:enterprise]) if summary %></td>
          <td class="px-4 py-2 text-right text-blue-900 text-lg underline decoration-double">
            <%= number_to_currency(summary[:total]) if summary %>
          </td>
          <td></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
