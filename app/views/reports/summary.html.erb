<% content_for :title, t('reports.summary.title') %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold"><%= t('reports.summary.title') %></h1>

  <%= form_with url: summary_reports_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :period, t('reports.summary.period'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.month_field :period, value: @result[:period].strftime('%Y-%m'),
          class: "border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-900" %>
    </div>
    <%= form.submit t('reports.summary.show'), class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-2 px-4 rounded" %>
  <% end %>

  <%= link_to t('reports.summary.export_csv'),
      summary_reports_path(format: :csv, period: @result[:period].strftime('%Y-%m')),
      class: "bg-green-600 hover:bg-green-700 text-white text-sm font-bold py-2 px-4 rounded",
      data: { turbo: false } %>
</div>

<div class="overflow-x-auto">
  <table class="min-w-full border-collapse border border-gray-300">
    <thead class="bg-gray-100 font-bold">
      <tr>
        <th class="border border-gray-300 px-3 py-2 text-left text-sm whitespace-nowrap"><%= t('reports.summary.brigade') %></th>
        <th class="border border-gray-300 px-3 py-2 text-left text-sm whitespace-nowrap"><%= t('reports.summary.book') %></th>
        <% Reports::SalarySummaryQuery::COLUMN_KEYS.each do |key| %>
          <th class="border border-gray-300 px-3 py-2 text-right text-sm whitespace-nowrap"><%= t("reports.summary_columns.#{key}") %></th>
        <% end %>
      </tr>
    </thead>

    <tbody class="divide-y divide-gray-200">
      <% @result[:brigades].each do |brigade_name, brigade_data| %>
        <% brigade_data[:books].each do |book_code, book_row| %>
          <tr class="bg-white">
            <td class="border border-gray-300 px-3 py-2 text-sm font-medium"><%= brigade_name %></td>
            <td class="border border-gray-300 px-3 py-2 text-sm pl-8"><%= book_code %></td>
            <% Reports::SalarySummaryQuery::COLUMN_KEYS.each do |key| %>
              <td class="border border-gray-300 px-3 py-2 text-right text-sm"><%= number_with_precision(book_row[key] || 0, precision: 2) %></td>
            <% end %>
          </tr>
        <% end %>

        <tr class="bg-gray-100 font-bold">
          <td class="border border-gray-300 px-3 py-2 text-sm" colspan="2"><%= t('reports.summary.brigade_total', brigade: brigade_name) %></td>
          <% Reports::SalarySummaryQuery::COLUMN_KEYS.each do |key| %>
            <td class="border border-gray-300 px-3 py-2 text-right text-sm"><%= number_with_precision(brigade_data[:total][key] || 0, precision: 2) %></td>
          <% end %>
        </tr>
      <% end %>

      <tr class="bg-gray-200 font-bold">
        <td class="border border-gray-300 px-3 py-2 text-sm" colspan="2"><%= t('reports.summary.grand_total') %></td>
        <% Reports::SalarySummaryQuery::COLUMN_KEYS.each do |key| %>
          <td class="border border-gray-300 px-3 py-2 text-right text-sm"><%= number_with_precision(@result[:grand_total][key] || 0, precision: 2) %></td>
        <% end %>
      </tr>
    </tbody>
  </table>
</div>

<% if @result[:brigades].empty? %>
  <div class="mt-4 text-gray-500"><%= t('reports.summary.empty') %></div>
<% end %>
