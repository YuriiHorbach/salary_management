<% content_for :title, t('sick_day_entries.new.title') %>

<div class="container mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2"><%= t('sick_day_entries.new.title') %></h1>

  <%= form_with url: new_sick_day_entry_path, method: :get,
      class: "mb-3 flex flex-wrap gap-4 items-end",
      data: { turbo_frame: "_top" } do |f| %>
    <div class="flex flex-col">
      <%= f.label :employee_search, t('sick_day_entries.new.search_label'), class: "text-sm font-medium mb-1" %>
      <%= f.text_field :employee_search, value: @employee_search,
          placeholder: t('sick_day_entries.new.search_placeholder'),
          class: "border border-gray-300 rounded-md px-3 py-2 text-sm" %>
    </div>

    <%= f.submit t('sick_day_entries.new.search'), class: "btn btn-primary font-medium py-2 px-4 rounded hover:bg-blue-600" %>
    <%= link_to t('sick_day_entries.new.reset'), new_sick_day_entry_path,
        class: "btn btn-secondary font-medium py-2 px-4 rounded" %>
  <% end %>

  <% if @employee_search.present? %>
    <p class="mb-4 text-sm text-gray-600">
      <%= t('sick_day_entries.new.found') %>
      <span id="sick_day_employee_search_count" class="font-semibold text-gray-900">
        <%= @employees.size %>
      </span>
    </p>

    <% if @employees.empty? %>
      <p class="mb-4 text-sm text-red-600"><%= t('common.no_matches') %></p>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "sick_day_entry_form" do %>
    <%= render "form", sick_day: @sick_day, employees: @employees %>
  <% end %>
</div>
