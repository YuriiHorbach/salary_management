<% content_for :title, "Налаштування системи" %>

<h1 class="text-2xl font-bold mb-6">Налаштування системи</h1>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
    <h2 class="text-lg font-semibold mb-4 text-blue-700">🏢 Теріторіальні ознаки (бригади)</h2>
    <p class="text-gray-600 mb-4">Керуйте списком бригад / територіальних ознак, які можна призначати працівникам.</p>
    <div class="flex gap-2">
      <%= link_to 'Додати бригаду', new_settings_territory_sign_path,
                  class: "btn btn-primary" %>
      <%= link_to 'Переглянути всі', settings_territory_signs_path,
                  class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
    <h2 class="text-lg font-semibold mb-4 text-green-700">📚 Облікові книги</h2>
    <p class="text-gray-600 mb-4">Керуйте книгами: назва, номер книги, номер сторінки.</p>
    <div class="flex gap-2">
      <%= link_to 'Додати книгу', new_settings_account_book_path,
                  class: "btn btn-primary" %>
      <%= link_to 'Переглянути всі', settings_account_books_path,
                  class: "btn btn-secondary" %>
    </div>
  </div>
</div>
