<% input_classes = "block w-full border border-gray-300 rounded px-2 py-1 text-sm bg-white focus:ring-2 focus:ring-blue-500 shadow-sm dark:bg-gray-800 dark:border-gray-600 dark:text-white" %>

<%= form_with(model: vacation, url: vacation_entries_path,
    class: "grid grid-cols-1 md:grid-cols-4 gap-4 items-end bg-green-50 dark:bg-green-900/20 py-4 px-4 rounded border border-green-200",
    data: { turbo_frame: "_top" }) do |f| %>

  <%= hidden_field_tag :employee_search, @employee_search %>

  <% if vacation.errors.any? %>
    <div class="md:col-span-4 text-sm text-red-600">
      <%= vacation.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :employee_id, t('vacation_entries.form.employee'), class: "block text-sm font-medium mb-1" %>

    <% if @employee_search.present? %>
      <% if employees.any? %>
        <div class="max-h-52 overflow-y-auto rounded border border-gray-300 bg-white p-2 shadow-sm dark:border-gray-600 dark:bg-gray-800">
          <%= f.collection_radio_buttons :employee_id, employees, :id, :full_name_with_id_code do |employee_option| %>
            <label class="flex cursor-pointer items-center gap-2 rounded px-2 py-1 text-sm hover:bg-blue-50 dark:hover:bg-gray-700">
              <%= employee_option.radio_button(class: "h-4 w-4 border-gray-300 text-blue-600") %>
              <span><%= employee_option.text %></span>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-red-600"><%= t('vacation_entries.form.other_search') %></p>
      <% end %>
    <% else %>
      <%= f.collection_select :employee_id, employees, :id, :full_name_with_id_code,
          { include_blank: t('vacation_entries.form.select_employee') },
          { class: input_classes, required: true } %>
    <% end %>
  </div>

  <div>
    <%= f.label :period, t('vacation_entries.form.period'), class: "block text-sm font-medium mb-1" %>
    <%= f.date_field :period,
        class: input_classes,
        value: vacation.period&.strftime("%Y-%m-%d"),
        required: true %>
  </div>

  <div>
    <%= f.label :vacation_amount, class: "block text-sm font-medium mb-1" do %>
      <%= t('vacation_entries.form.vacation_amount') %> <span class="text-xs font-normal text-gray-500"><%= t('common.example') %></span>
    <% end %>
    <%= f.number_field :vacation_amount,
        value: (vacation.vacation_amount if vacation.vacation_amount_cents.to_i.positive?),
        min: 0, step: 0.01, class: "#{input_classes} text-right",
        required: true %>
  </div>

  <div class="flex items-center gap-4">
    <%= f.submit t('vacation_entries.form.save'), class: "btn btn-primary font-medium py-2 px-4 rounded hover:bg-blue-600" %>
    <%= link_to t('vacation_entries.form.cancel'), employees_path,
        class: "text-gray-600 hover:text-gray-900 underline",
        data: { turbo_frame: "_top" } %>
  </div>
<% end %>
