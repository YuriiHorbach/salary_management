<%= turbo_frame_tag "salary_amount_employee_#{@employee.id}" do %>
  <%= form_with model: [@employee, @salary],
                url: employee_salaries_path(@employee, department_id: @salary.department_id,
                                                       period: @salary.month),
                method: :post,
                class: "inline-block" do |form| %>

    <%= form.hidden_field :department_id %>
    <%= form.hidden_field :paid_on, value: @salary.period %>
    <%= form.hidden_field :period, value: @salary.month %>

    <% if @salary.errors.any? %>
      <p class="text-xs text-red-600"><%= @salary.errors.full_messages.to_sentence %></p>
    <% end %>

    <%= form.number_field :amount,
                          step: :any,
                          min: 0,
                          value: nil,
                          autofocus: true,
                          data: { controller: "auto-submit", action: "blur->auto-submit#submit" },
                          class: "w-20 p-1 text-xs border rounded border-blue-500 outline-none focus:ring-1 focus:ring-blue-500 font-mono" %>

    <%= form.collection_select :position_id, @positions || [], :id, :position_name,
                               { include_blank: 'Без посади' },
                               { class: "p-1 text-xs border rounded border-blue-500 outline-none focus:ring-1 focus:ring-blue-500" } %>
  <% end %>
<% end %>
