<nav class="bg-blue-500 px-4 py-4 text-white sm:px-6 lg:px-8" data-controller="menu">
  <div class="mx-auto flex w-full max-w-screen-2xl flex-wrap items-center justify-between gap-3">
    <div class="text-lg font-bold">
      <%= link_to t('navigation.app_name'), root_path, class: 'hover:text-blue-200' %>
    </div>

    <%# Full-width below `lg` so the expanded mobile menu spans the whole
        navbar (the burger only exists under `lg`); shrink-to-fit from `lg`
        so the links sit inline next to the locale switcher. %>
    <div class="flex w-full flex-wrap items-center justify-between gap-3 lg:w-auto lg:justify-start">
      <div class="flex items-center gap-1 rounded-md bg-blue-600/50 p-1" aria-label="<%= t('locales.switch') %>">
        <% supported_locales.each do |locale| %>
          <%= link_to t("locales.short.#{locale}"),
                      locale_switch_path(locale),
                      class: locale_link_classes(locale),
                      title: t("locales.#{locale}"),
                      aria: { current: (I18n.locale == locale ? 'page' : nil) } %>
        <% end %>
      </div>

      <button id="menu-toggle"
              type="button"
              class="rounded border px-3 py-2 hover:bg-blue-600 lg:hidden"
              aria-controls="menu"
              aria-expanded="false"
              data-menu-target="toggle"
              data-action="menu#toggle">
        <span class="sr-only"><%= t('navigation.toggle_menu') %></span>
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>

      <%# Collapsed below `lg`; the menu controller toggles `hidden`/`flex`
          on mobile, `lg:flex` keeps it inline on desktop. %>
      <div id="menu"
           class="hidden w-full flex-col gap-1 lg:w-auto lg:flex lg:flex-row lg:items-center lg:gap-4"
           data-menu-target="menu">
        <%= link_to t('navigation.departments'), departments_path, class: 'hover:text-blue-200' %>
        <%= link_to t('navigation.employees'), employees_path, class: 'hover:text-blue-200' %>

        <details class="relative" data-controller="dropdown" data-action="toggle->dropdown#toggle">
          <summary class="flex cursor-pointer select-none items-center gap-1">
            <span><%= t('navigation.more') %></span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="absolute left-0 top-full z-50 mt-1 min-w-56 max-w-[calc(100vw-2rem)] whitespace-nowrap rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
            <%= link_to t('navigation.sick_days'), new_sick_day_entry_path, class: 'block px-4 py-2 text-gray-800 hover:bg-gray-100' %>
            <%= link_to t('navigation.vacations'), new_vacation_entry_path, class: 'block px-4 py-2 text-gray-800 hover:bg-gray-100' %>
            <%= link_to t('navigation.historical_import'), new_historical_import_path, class: 'block px-4 py-2 text-gray-800 hover:bg-gray-100' %>
          </div>
        </details>

        <details class="relative" data-controller="dropdown" data-action="toggle->dropdown#toggle">
          <summary class="flex cursor-pointer select-none items-center gap-1">
            <span><%= t('navigation.reports') %></span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="absolute left-0 top-full z-50 mt-1 min-w-56 max-w-[calc(100vw-2rem)] whitespace-nowrap rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
            <%= link_to t('navigation.summary_report'), summary_reports_path, class: 'block px-4 py-2 text-gray-800 hover:bg-gray-100' %>
            <%= link_to t('navigation.detailed_report'), detailed_reports_path, class: 'block px-4 py-2 text-gray-800 hover:bg-gray-100' %>
          </div>
        </details>

        <details class="relative" data-controller="dropdown" data-action="toggle->dropdown#toggle">
          <summary class="flex cursor-pointer select-none items-center gap-1">
            <span><%= t('navigation.settings') %></span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="absolute left-0 top-full z-50 mt-1 min-w-56 max-w-[calc(100vw-2rem)] whitespace-nowrap rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
            <%= link_to t('navigation.system_settings'), settings_root_path, class: 'block px-4 py-2 text-gray-800 hover:bg-gray-100' %>
            <%= link_to t('navigation.brigades'), settings_territory_signs_path, class: 'block px-4 py-2 text-gray-800 hover:bg-gray-100' %>
            <%= link_to t('navigation.books'), settings_account_books_path, class: 'block px-4 py-2 text-gray-800 hover:bg-gray-100' %>
          </div>
        </details>

        <% if user_signed_in? %>
          <%= link_to t('navigation.logout'), destroy_user_session_path, data: { turbo_method: :delete }, class: 'hover:text-blue-200' %>
        <% else %>
          <%= link_to t('navigation.login'), new_user_session_path, class: 'hover:text-blue-200' %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
