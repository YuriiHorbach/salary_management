<% content_for :title, "Облікові книги" %>

<h1 class="text-2xl font-bold mb-6">Облікові книги</h1>

<div class="flex justify-between items-center mb-6">
  <div></div>
  <div class="flex gap-2">
    <%= link_to 'Назад до налаштувань', settings_root_path, class: "text-gray-600 hover:text-blue-600 px-4 py-2 rounded-md text-sm font-medium" %>
    <%= link_to 'Додати нову', new_settings_account_book_path,
                class: "btn btn-primary" %>
  </div>
</div>

<div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Код книги</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Дія</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% if @account_books.any? %>
        <% @account_books.each do |book| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-mono"><%= book.code || '—' %></td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to 'Редагувати', edit_settings_account_book_path(book),
                          class: "text-blue-600 hover:text-blue-800 underline text-sm" %>
              <%= link_to 'Видалити', settings_account_book_path(book),
                          method: :delete,
                          data: { confirm: 'Ви дійсно хочете видалити цю книгу?' },
                          class: "text-red-600 hover:text-red-800 underline text-sm ml-4" %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="2" class="px-6 py-4 text-center text-sm text-gray-500">
            Книг не знайдено. Додайте першу.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
