<h1><%= @department.name %></h1>

<div class="grid grid-cols-5 border-b border-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800">
  <div class="px-4 py-2 border border-gray-300">ID</div>
  <div class="px-4 py-2 border border-gray-300">Last name</div>
  <div class="px-4 py-2 border border-gray-300">First name</div>
  <div class="px-4 py-2 border border-gray-300">Patronic name</div>
  <div class="px-4 py-2 border border-gray-300">Add salary</div>
</div>

<% @department&.employees&.each do |employee| %>
  <div class="grid grid-cols-5 border border-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800">
    <div class="px-2 py-2 border border-gray-300"><%= employee.id_code %></div>
    <div class="px-2 py-2 border border-gray-300"><%= employee.last_name %></div>
    <div class="px-2 py-2 border border-gray-300"><%= employee.first_name %></div>
    <div class="px-2 py-2 border border-gray-300"><%= employee.patronic_name %></div>
    <div class="px-2 py-2 border border-gray-300">
      <%= turbo_frame_tag "salary_form_employee_#{employee.id}" do %>
        <%= link_to "Add Salary", new_employee_salary_path(employee.id, department_id: @department.id), class: "text-xs text-blue-700 hover:text-white border border-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg px-2 py-1 text-center dark:border-blue-500 dark:text-blue-500 dark:hover:text-white dark:hover:bg-blue-500 dark:focus:ring-blue-800" %>
      <% end %>
      <%= link_to "Show Salary", employee_salaries_path(employee.id) %>
    </div>
  </div>
<% end %>

<br>
<%= link_to 'Add Employees', new_department_employee_path(department_id: @department.id), class: "mt-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" %>
