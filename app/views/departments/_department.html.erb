<%= turbo_frame_tag dom_id(department) do %>
  <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
    <%= link_to department.name, department_path(department), data: { turbo: false }, class: "hover:underline text-gray-600 font-semibold" %>
    <p class="mt-2 text-sm text-gray-600">
      <%= t('departments.card.employees') %>:
      <span id="department_<%= department.id %>_employee_count" class="font-semibold text-gray-900">
        <%= employee_counts.fetch(department.id, 0) %>
      </span>
    </p>
    <div class="flex justify-between items-center mt-4">
      <%= link_to t('departments.card.edit'), edit_department_path(department), class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
      <%= button_to t('departments.card.delete', default: t('common.delete', default: 'Delete')),
                    department_path(department),
                    method: :delete,
                    data: { turbo_confirm: t('common.confirm_delete', default: 'Are you sure?') },
                    class: "text-red-600 hover:text-red-800 text-sm font-medium transition cursor-pointer" %>
    </div>
  </div>
<% end %>
