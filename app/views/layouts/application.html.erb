<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · #{t('navigation.app_name')}" : t('navigation.app_name') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Mobile-first shell: full-height flex column so the main area can stretch
      and every page content stays within one responsive max-width container. %>
  <body class="flex min-h-screen flex-col bg-gray-50">
    <%= render "layouts/navigation" %>

    <div id="flash" class="mx-auto w-full max-w-screen-2xl px-4 pt-4 sm:px-6 lg:px-8">
      <%= render 'shared/flash' %>
    </div>

    <main class="mx-auto w-full max-w-screen-2xl flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <%= yield %>
    </main>
  </body>
</html>
