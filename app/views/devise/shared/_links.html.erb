<div class="max-w-md mx-auto mt-10">
  <%- if controller_name != 'sessions' %>
     <%= link_to t('devise_views.links.login'), new_session_path(resource_name), class: "block w-full px-3 py-2 border border-gray-300 rounded hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-200 text-center" %><br />
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
     <%= link_to t('devise_views.links.sign_up'), new_registration_path(resource_name), class: "btn btn-primary btn-xs block w-full p-2 text-center" %><br />
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to t('devise_views.links.forgot'), new_password_path(resource_name) %><br />
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to t('devise_views.links.no_confirmation'), new_confirmation_path(resource_name) %><br />
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to t('devise_views.links.no_unlock'), new_unlock_path(resource_name) %><br />
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to t('devise_views.links.sign_in_with', provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false } %><br />
    <% end %>
  <% end %>
</div>
