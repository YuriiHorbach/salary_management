<% content_for :title, t('historical_imports.new.title') %>

<h1 class="text-2xl font-bold mb-6"><%= t('historical_imports.new.title') %></h1>

<div class="m-5 bg-gray-50 p-4 rounded-xl shadow-sm border border-gray-200">
  <%= form_with url: historical_imports_path, method: :post, multipart: true, class: "space-y-4" do |f| %>
    <div class="flex flex-col">
      <%= f.label :file, t('historical_imports.new.file'), class: "text-xs font-bold text-gray-600 mb-1" %>
      <%= f.file_field :file, accept: ".csv,text/csv", class: "border border-gray-300 rounded-lg p-2 text-sm" %>
    </div>

    <div class="flex flex-col">
      <%= f.label :data_type, t('historical_imports.new.data_type'),
            class: "text-xs font-bold text-gray-600 mb-1" %>
      <%= f.select :data_type,
            [[t('historical_imports.new.auto'), ""],
             [t('historical_imports.new.salary'), "salary"],
             [t('historical_imports.new.sick_day'), "sick_day"],
             [t('historical_imports.new.vacation'), "vacation"]],
            {},
            class: "border border-gray-300 rounded-lg p-2 text-sm" %>
    </div>

    <%= f.submit t('historical_imports.new.submit'),
          class: "btn btn-primary font-medium py-2 px-4 rounded hover:bg-blue-600 cursor-pointer" %>
  <% end %>
</div>

<div class="m-5 bg-white p-4 rounded-xl shadow-sm border border-gray-200 text-sm text-gray-700">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
    <h2 class="text-lg font-bold"><%= t('historical_imports.new.format_title') %></h2>
    <%= link_to t('historical_imports.new.download_sample'),
          sample_historical_imports_path,
          class: "text-sm font-medium text-blue-600 hover:text-blue-800 underline",
          data: { turbo: false } %>
  </div>
  <p class="mb-2">
    <%= raw t('historical_imports.new.intro_html') %>
  </p>
  <div class="mt-3 overflow-x-auto">
    <table id="csv-columns" class="min-w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200 text-left text-xs uppercase text-gray-500">
          <th class="py-2 pr-4 font-semibold"><%= t('historical_imports.new.columns.column') %></th>
          <th class="py-2 pr-4 font-semibold"><%= t('historical_imports.new.columns.meaning') %></th>
          <th class="py-2 font-semibold"><%= t('historical_imports.new.columns.when') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <tr>
          <td class="py-2 pr-4 align-top"><code>type</code></td>
          <td class="py-2 pr-4 align-top">
            <%= raw t('historical_imports.new.columns.type.meaning_html') %>
          </td>
          <td class="py-2 align-top">
            <%= raw t('historical_imports.new.columns.type.when_html') %>
          </td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>id_code</code></td>
          <td class="py-2 pr-4 align-top">
            <%= t('historical_imports.new.columns.id_code.meaning') %>
          </td>
          <td class="py-2 align-top">
            <%= raw t('historical_imports.new.columns.id_code.when_html') %>
          </td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>identifier</code></td>
          <td class="py-2 pr-4 align-top">
            <%= t('historical_imports.new.columns.identifier.meaning') %>
          </td>
          <td class="py-2 align-top">
            <%= raw t('historical_imports.new.columns.identifier.when_html') %>
          </td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>period</code></td>
          <td class="py-2 pr-4 align-top">
            <%= raw t('historical_imports.new.columns.period.meaning_html') %>
          </td>
          <td class="py-2 align-top"><%= t('historical_imports.new.columns.period.when') %></td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>amount</code></td>
          <td class="py-2 pr-4 align-top"><%= t('historical_imports.new.columns.amount.meaning') %></td>
          <td class="py-2 align-top"><%= raw t('historical_imports.new.columns.amount.when_html') %></td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>pfu_amount</code></td>
          <td class="py-2 pr-4 align-top">
            <%= t('historical_imports.new.columns.pfu_amount.meaning') %>
          </td>
          <td class="py-2 align-top"><%= raw t('historical_imports.new.columns.pfu_amount.when_html') %></td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>enterprise_amount</code></td>
          <td class="py-2 pr-4 align-top">
            <%= t('historical_imports.new.columns.enterprise_amount.meaning') %>
          </td>
          <td class="py-2 align-top"><%= raw t('historical_imports.new.columns.enterprise_amount.when_html') %></td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>vacation_amount</code></td>
          <td class="py-2 pr-4 align-top"><%= t('historical_imports.new.columns.vacation_amount.meaning') %></td>
          <td class="py-2 align-top"><%= raw t('historical_imports.new.columns.vacation_amount.when_html') %></td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>income_tax</code></td>
          <td class="py-2 pr-4 align-top"><%= t('historical_imports.new.columns.income_tax.meaning') %></td>
          <td class="py-2 align-top"><%= raw t('historical_imports.new.columns.income_tax.when_html') %></td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>military_tax</code></td>
          <td class="py-2 pr-4 align-top"><%= t('historical_imports.new.columns.military_tax.meaning') %></td>
          <td class="py-2 align-top"><%= raw t('historical_imports.new.columns.military_tax.when_html') %></td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>net_amount</code></td>
          <td class="py-2 pr-4 align-top">
            <%= t('historical_imports.new.columns.net_amount.meaning') %>
          </td>
          <td class="py-2 align-top">
            <%= raw t('historical_imports.new.columns.net_amount.when_html') %>
          </td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>department</code></td>
          <td class="py-2 pr-4 align-top">
            <%= t('historical_imports.new.columns.department.meaning') %>
          </td>
          <td class="py-2 align-top">
            <%= t('historical_imports.new.columns.department.when') %>
          </td>
        </tr>
        <tr>
          <td class="py-2 pr-4 align-top"><code>paid_on</code></td>
          <td class="py-2 pr-4 align-top">
            <%= raw t('historical_imports.new.columns.paid_on.meaning_html') %>
          </td>
          <td class="py-2 align-top">
            <%= raw t('historical_imports.new.columns.paid_on.when_html') %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="mt-2 text-gray-600">
    <%= t('historical_imports.new.sample_hint') %>
  </p>
  <p class="mt-3">
    <%= raw t('historical_imports.new.taxes_html') %>
  </p>
  <p class="mt-2">
    <%= t('historical_imports.new.update_hint') %>
  </p>
</div>
