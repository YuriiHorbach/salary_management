<%= turbo_frame_tag "salary_form_employee_#{@employee.id}" do %>
  <%= form_with model: [@employee, @salary], url: employee_salaries_path(@employee, department_id: params[:department_id]), method: :post, class: "gap-1" do |form| %>

    <div class="">
      <%= form.number_field :amount, step: :any, placeholder: "Сума", class: "w-20 p-1 text-xs border rounded outline-none" %>
    </div>
    <div class="">
      <%= form.date_select :paid_on, { discard_day: true, order: [:year, :month] }, { class: "p-1 text-xs border rounded bg-white text-gray-700" } %>
    </div>

    <div class="">
      <%= form.submit "Save", class: "cursor-pointer px-2 py-0.5 text-[10px] bg-green-600 hover:bg-green-700 text-black font-medium rounded" %>
      <%= link_to "Cancel", new_employee_salary_path(@employee.id, department_id: params[:department_id]), class: "px-2 py-0.5 text-[10px] bg-black-500 hover:bg-gray-600 text-black font-medium rounded text-center" %>
    </div>
  <% end %>
<% end %>
