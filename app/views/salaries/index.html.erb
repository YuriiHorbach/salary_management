<h1 class="text-2xl font-bold mb-4">Salary Records for <%=  "#{@employee.last_name} #{@employee.first_name} #{@employee.patronic_name}" %></h1>

<div class="m-5">
  <div class="grid grid-cols-6 gap-x-3 border-b border-gray-300 font-semibold text-sm">
    <div class="px-2 py-2">Сума</div>
    <div class="px-2 py-2">Період</div>
    <div class="px-2 py-2">Дії</div>
  </div>

  <%= turbo_frame_tag "new_salary" %>
  <%= render partial: 'salary', collection: @salaries, as: :salary %>
</div>

<div> <%= link_to "Back", :back, class: "btn btn-primary btn-xs mt-4 rounded" %> </div>
