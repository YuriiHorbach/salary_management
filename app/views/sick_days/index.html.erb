<div class="container mx-auto px-4 py-6">
  <% actions = capture do %>
    <%= link_to t('sick_days.index.add'), new_employee_sick_day_path(@employee),
                class: "btn btn-primary btn-xs rounded-md font-medium transition shadow-sm inline-block" %>

    <%= link_to t('sick_days.index.back'), employee_path(@employee),
                class: "text-gray-600 hover:text-gray-900 underline" %>
  <% end %>

  <%= render 'shared/page_header',
             title: t('sick_days.index.title', name: "#{@employee.last_name} #{@employee.first_name}"),
             actions: actions %>

  <%= render 'list', sick_days: @sick_days, sick_days_summaries: @sick_days_summaries %>
</div>
