<h1>Зведений звіт по зарплатах (по відділах)</h1>

<div class="filter-form flex mb-4 mt-4">
  <%= search_form_for @q, url: reports_path, method: :get, class: "flex space-x-3 flex-auto", data: { turbo_frame: "report_results" } do |f| %>
    <div class="field flex-initial flex space-x-2">
      <%= f.label :by_year, "Рік", class: "mt-1" %>
      <%= f.select :by_year,
          options_for_select(year_options, params.dig(:q, :by_year).to_s),
          { include_blank: 'Всі роки' },
          class: "border border-gray-300 rounded-md px-4 w-auto"
      %>
    </div>

    <div class="field flex-initial flex space-x-2">
      <%= f.label :by_month, "Місяць", class: "mt-1" %>
      <%= f.select :by_month, options_for_select(month_options, params.dig(:q, :by_month).to_i),
          { include_blank: 'Всі місяці' },
          class: "select border border-gray-300 rounded-md px-4 w-auto" %>
    </div>

    <div class="field flex-initial flex space-x-2">
      <%= f.label :by_department, "Відділ", class: "mt-1" %>
      <%= f.select :by_department, options_from_collection_for_select(@departments, 'id', 'name', params.dig(:q, :by_department)),
          { include_blank: 'Всі відділи' },
          class: "select border border-gray-300 rounded-md px-4 w-auto" %>
    </div>

    <%= f.submit "Фільтрувати", class: "btn btn-primary btn-xs font-bold py-2 px-4 rounded hover:bg-blue-700" %>
  <% end %>
</div>

<hr>

<%= turbo_frame_tag "report_results" do %>
  <h2 class="mt-4 mb-2 text-xl font-semibold">Результати звіту</h2>

  <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Відділ
          </th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
            Брутто зп
          </th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
            Чиста зп
          </th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
            ПДФО
          </th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
            Військовий збір
          </th>
        </tr>
      </thead>

      <tbody class="bg-white divide-y divide-gray-200">
        <% if @monthly_department_salaries.any? %>
          <% @monthly_department_salaries.each do |department_name, department_totals| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= department_name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">
                <%= humanized_money(Money.from_cents(department_totals[:gross], "UAH")) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">
                <%= humanized_money(Money.from_cents(department_totals[:net], "UAH")) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">
                <%= humanized_money(Money.from_cents(department_totals[:pdfo], "UAH")) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">
                <%= humanized_money(Money.from_cents(department_totals[:military_tax], "UAH")) %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-6 py-4 text-center text-sm text-gray-500">
              Даних за вибраний період не знайдено.
            </td>
          </tr>
        <% end %>
      </tbody>

      <tfoot class="bg-gray-100 font-bold">
        <tr>
          <th scope="row" class="px-6 py-3 text-left text-xs text-gray-700 uppercase tracking-wider">
            Загальний підсумок
          </th>

          <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900 text-right">
            <%= humanized_money(Money.from_cents(@total_records[:gross], "UAH")) %>
          </td>

          <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900 text-right">
            <%= humanized_money(Money.from_cents(@total_records[:net], "UAH")) %>
          </td>

          <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900 text-right">
            <%= humanized_money(Money.from_cents(@total_records[:income_tax], "UAH")) %>
          </td>

          <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900 text-right">
            <%= humanized_money(Money.from_cents(@total_records[:military_tax], "UAH")) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>
