<h1><%= @department.name %></h1>

<% position_context = { period: @period.strftime('%Y-%m') } %>
<% position_context[:position] = @position.id if @position %>

<%= form_with url: department_path(@department), method: :get,
    class: "my-4 flex flex-wrap items-end gap-3" do |form| %>
  <div>
    <%= form.label :period, "Період", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.month_field :period, value: @period.strftime('%Y-%m'),
        class: "border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-900" %>
  </div>

  <div>
    <%= form.label :position, "Посада", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :position,
        options_from_collection_for_select(@positions, :id, :position_name, params[:position]),
        { include_blank: 'Всі посади' },
        class: "border border-gray-300 rounded-md px-3 py-2 text-sm bg-white text-gray-900" %>
  </div>

  <%= form.submit "Показати", class: "btn btn-primary btn-xs rounded-md font-medium transition shadow-sm" %>
<% end %>

<table class="w-full table-auto border-collapse text-sm">
  <thead>
    <tr class="bg-gray-100">
      <th class="px-3 py-2 border border-gray-300 text-left"><%= sort_link(@q, :id_code, "ID") %></th>
      <th class="px-3 py-2 border border-gray-300 text-left"><%= sort_link(@q, :last_name, "Last name") %></th>
      <th class="px-3 py-2 border border-gray-300 text-left"><%= sort_link(@q, :first_name, "First name") %></th>
      <th class="px-3 py-2 border border-gray-300 text-left"><%= sort_link(@q, :patronic_name, "Patronic name") %></th>
      <th class="px-3 py-2 border border-gray-300 text-left whitespace-nowrap">Посада</th>
      <th class="px-3 py-2 border border-gray-300 text-left whitespace-nowrap">
        Зарплата за <%= @period.strftime('%m-%Y') %>
      </th>
      <th class="px-3 py-2 border border-gray-300 text-left whitespace-nowrap">View salary</th>
      <th class="px-3 py-2 border border-gray-300 text-center whitespace-nowrap">Remove employee</th>
    </tr>
  </thead>
  <tbody>
    <% @employees.each do |employee| %>
      <tr id="department_employee_<%= employee.id %>" class="hover:bg-gray-50">
        <td class="px-3 py-2 border border-gray-300 whitespace-nowrap">
          <%= link_to employee.id_code, employee_path(employee), class: "underline text-blue-600 hover:text-blue-800 text-xs" %>
        </td>
        <td class="px-3 py-2 border border-gray-300 truncate"><%= employee.last_name %></td>
        <td class="px-3 py-2 border border-gray-300 truncate"><%= employee.first_name %></td>
        <td class="px-3 py-2 border border-gray-300 truncate"><%= employee.patronic_name %></td>
        <td class="px-3 py-2 border border-gray-300">
          <% employee_positions = @employee_positions.fetch(employee.id, []) %>
          <% if employee_positions.any? %>
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <% employee_positions.each do |position| %>
                <%= link_to position.position_name,
                            edit_department_employee_positions_path(department_id: @department.id,
                                                                    employee_id: employee.id,
                                                                    **position_context),
                            class: "text-blue-600 hover:underline text-xs",
                            title: "Редагувати посади" %>
              <% end %>
            </div>
          <% else %>
            <%= link_to 'Додати посаду',
                        edit_department_employee_positions_path(department_id: @department.id,
                                                                employee_id: employee.id,
                                                                **position_context),
                        class: "text-blue-600 hover:underline text-xs" %>
          <% end %>
        </td>
        <td class="px-3 py-2 border border-gray-300">
          <%= render 'departments/salary_cell',
                     employee: employee,
                     department: @department,
                     period: @period,
                     positions: employee_positions,
                     period_salaries: @period_salaries,
                     filter_position_id: @position&.id %>
        </td>
        <td class="px-3 py-2 border border-gray-300 whitespace-nowrap">
          <%= link_to "Salary", employee_salaries_path(employee, department_id: @department.id,
                                                                period: @period.strftime('%Y-%m')),
                      class: "text-blue-600 hover:underline" %>
        </td>
        <td class="px-3 py-2 border border-gray-300 text-center whitespace-nowrap">
          <%= link_to '❌', remove_department_employee_path(department_id: @department.id, id: employee.id),
              data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' },
              class: "text-red-500 font-black text-lg hover:text-red-700 leading-none",
              title: "Remove from department" %>
        </td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="bg-gray-50 font-medium">
      <td colspan="5" class="px-3 py-2 border border-gray-300 text-right">
        Всього за <%= l(@period, format: :short) %><%= " (посада: #{@position.position_name})" if @position %>:
      </td>
      <td class="px-3 py-2 border border-gray-300 whitespace-nowrap font-mono">
        <span id="department_total">
          <%= number_to_currency(@department_total) %>
        </span>
      </td>
      <td class="px-3 py-2 border border-gray-300"></td>
      <td class="px-3 py-2 border border-gray-300"></td>
    </tr>
  </tfoot>
</table>
<br>
<%= link_to 'Add Employees', new_department_employee_path(department_id: @department.id), class: "btn btn-primary btn-xs mt-4 py-2 rounded hover:bg-blue-700" %>
