<p><%= t('devise_views.mailers.hello', email: @email) %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= t('devise_views.mailers.email_changed_to', email: @resource.unconfirmed_email) %></p>
<% else %>
  <p><%= t('devise_views.mailers.email_changed', email: @resource.email) %></p>
<% end %>
